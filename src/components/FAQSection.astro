---
import { FAQ_DATA, FAQ_CATEGORIES, generateFAQSchema } from '../lib/faqData';

interface Props {
  title?: string;
  subtitle?: string;
  includeSchema?: boolean;
  initialCategory?: string;
}

const {
  title = "Frequently Asked Questions",
  subtitle = "Expert answers on touch typing techniques, speed benchmarks, keyboard history, finger placement, and free arcade games.",
  includeSchema = true,
  initialCategory = "all"
} = Astro.props;

const faqSchema = generateFAQSchema(FAQ_DATA);
---

<section class="rounded-3xl border border-hairline bg-canvas p-6 sm:p-10 shadow-level-2 scroll-mt-20" id="faq-section">
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-hairline">
    <div>
      <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-soft px-3.5 py-1 text-xs font-mono text-link shadow-level-1 mb-3">
        <span>💡 KNOWLEDGE BASE & FAQ</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-ink leading-tight">
        {title}
      </h2>
      <p class="text-xs sm:text-sm text-body mt-2 max-w-2xl leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Quick Controls: Search + Expand All -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full md:w-auto">
      <div class="relative w-full sm:w-64">
        <input
          type="text"
          id="faq-search-input"
          placeholder="Search 37 questions..."
          class="w-full rounded-full border border-hairline bg-canvas-soft px-4 py-2.5 pl-9 text-xs font-mono text-ink shadow-level-1 focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20"
          aria-label="Search frequently asked questions"
        />
        <svg class="absolute left-3 top-3 h-4 w-4 text-mute pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <button
        type="button"
        id="faq-toggle-all-btn"
        class="inline-flex items-center justify-center gap-1.5 rounded-full border border-hairline bg-canvas-soft px-4 py-2.5 text-xs font-mono font-medium text-body hover:text-ink hover:bg-canvas shadow-level-1 transition active:scale-95 whitespace-nowrap cursor-pointer"
      >
        <span id="faq-toggle-icon">🔽</span>
        <span id="faq-toggle-text">Expand All</span>
      </button>
    </div>
  </div>

  <!-- Category Filter Pills -->
  <div class="flex items-center gap-2 pt-6 pb-6 border-b border-hairline/60 overflow-x-auto no-scrollbar max-w-full" id="faq-category-filters">
    {FAQ_CATEGORIES.map((cat, idx) => (
      <button
        type="button"
        data-faq-category={cat.id}
        class={`faq-cat-btn flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-medium transition cursor-pointer whitespace-nowrap flex-shrink-0 ${
          (cat.id === initialCategory || (initialCategory === 'all' && idx === 0))
            ? 'active bg-ink text-on-primary shadow-level-1'
            : 'border border-hairline bg-canvas-soft text-body hover:text-ink hover:bg-canvas'
        }`}
        style={(cat.id === initialCategory || (initialCategory === 'all' && idx === 0)) ? 'background-color: var(--site-primary, #e2b714); color: var(--site-on-primary, #323437);' : ''}
      >
        <span>{cat.icon}</span>
        <span>{cat.label}</span>
        <span class="rounded-full bg-black/10 dark:bg-white/10 px-1.5 py-0.2 text-[10px] font-mono opacity-80">{cat.count}</span>
      </button>
    ))}
  </div>

  <!-- Result Counter -->
  <div class="py-4 flex items-center justify-between text-xs font-mono text-mute">
    <div>
      Showing <span id="faq-visible-count" class="font-bold text-ink">{FAQ_DATA.length}</span> of {FAQ_DATA.length} questions
    </div>
    <div id="faq-active-filter-label" class="hidden sm:block text-[11px]">
      Category: <span class="text-ink font-semibold">All Questions</span>
    </div>
  </div>

  <!-- FAQ Accordion List -->
  <div class="space-y-3 font-sans" id="faq-items-list">
    {FAQ_DATA.map((item, index) => (
      <details
        class="faq-item group rounded-2xl border border-hairline bg-canvas-soft/80 p-4 sm:p-5 transition hover:border-link/40 cursor-pointer"
        data-category={item.category}
        data-id={item.id}
        data-question={item.question.toLowerCase()}
        data-keywords={item.keywords.join(' ').toLowerCase()}
        data-text={item.shortAnswer.toLowerCase()}
        open={index === 0}
      >
        <summary class="flex items-start sm:items-center justify-between gap-4 font-bold text-ink text-sm sm:text-base select-none list-none">
          <div class="flex items-center gap-2.5">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-canvas text-xs font-mono font-bold text-mute border border-hairline group-open:text-ink group-open:border-[var(--site-primary)]">
              {index + 1}
            </span>
            <span class="text-ink capitalize-first leading-snug">
              {item.question}
            </span>
          </div>
          
          <div class="flex items-center gap-2 shrink-0">
            <span class="hidden md:inline-block rounded-full bg-canvas border border-hairline px-2.5 py-0.5 text-[10px] font-mono text-mute">
              {item.categoryLabel}
            </span>
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-canvas text-xs font-mono text-mute transition-transform duration-200 group-open:rotate-180 border border-hairline">
              ▼
            </span>
          </div>
        </summary>

        <div class="mt-3.5 text-xs sm:text-sm text-body leading-relaxed border-t border-hairline pt-3.5 pl-1 sm:pl-8 space-y-2">
          <div set:html={item.answerHtml} />
          
          <div class="mt-3 pt-2 flex flex-wrap items-center gap-1.5 font-mono text-[10px] text-mute border-t border-hairline/40">
            <span class="font-semibold uppercase text-mute">Related:</span>
            {item.keywords.map(kw => (
              <span class="rounded bg-canvas px-1.5 py-0.5 border border-hairline/60">#{kw}</span>
            ))}
          </div>
        </div>
      </details>
    ))}
  </div>

  <!-- Zero Results Fallback -->
  <div id="faq-no-results" class="hidden py-16 text-center">
    <div class="text-4xl mb-2">🔍</div>
    <h3 class="text-base font-semibold text-ink">No matching questions found</h3>
    <p class="text-xs text-mute mt-1">Try changing your search query or clicking "All Questions".</p>
    <button
      type="button"
      id="faq-reset-search-btn"
      class="mt-4 inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas px-4 py-2 text-xs font-medium text-ink shadow-level-1 transition hover:bg-canvas-soft cursor-pointer"
    >
      <span>Reset Filters</span>
    </button>
  </div>
</section>

{includeSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

<script>
  function initFAQSection() {
    const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
    const catBtns = document.querySelectorAll('.faq-cat-btn');
    const items = document.querySelectorAll('.faq-item') as NodeListOf<HTMLDetailsElement>;
    const visibleCountEl = document.getElementById('faq-visible-count');
    const filterLabelEl = document.querySelector('#faq-active-filter-label span');
    const noResultsEl = document.getElementById('faq-no-results');
    const resetBtn = document.getElementById('faq-reset-search-btn');
    const toggleAllBtn = document.getElementById('faq-toggle-all-btn');
    const toggleIcon = document.getElementById('faq-toggle-icon');
    const toggleText = document.getElementById('faq-toggle-text');

    let currentCategory = 'all';
    let searchQuery = '';
    let isAllExpanded = false;

    function applyFilter() {
      let count = 0;

      items.forEach(item => {
        const itemCat = item.getAttribute('data-category') || '';
        const itemQ = item.getAttribute('data-question') || '';
        const itemKW = item.getAttribute('data-keywords') || '';
        const itemTxt = item.getAttribute('data-text') || '';

        const matchesCat = (currentCategory === 'all' || itemCat === currentCategory);
        const matchesSearch = (
          searchQuery === '' ||
          itemQ.includes(searchQuery) ||
          itemKW.includes(searchQuery) ||
          itemTxt.includes(searchQuery)
        );

        if (matchesCat && matchesSearch) {
          (item as HTMLElement).style.display = 'block';
          count++;
          // If searching, auto-open matching details
          if (searchQuery.length > 2) {
            item.open = true;
          }
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });

      if (visibleCountEl) visibleCountEl.textContent = count.toString();

      if (noResultsEl) {
        if (count === 0) noResultsEl.classList.remove('hidden');
        else noResultsEl.classList.add('hidden');
      }
    }

    // Search input listener
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      applyFilter();
    });

    // Reset button
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      currentCategory = 'all';

      catBtns.forEach((b, i) => {
        b.classList.remove('active');
        (b as HTMLElement).style.backgroundColor = '';
        (b as HTMLElement).style.color = '';
        if (i === 0) {
          b.classList.add('active');
          (b as HTMLElement).style.backgroundColor = 'var(--site-primary, #e2b714)';
          (b as HTMLElement).style.color = 'var(--site-on-primary, #323437)';
        }
      });

      if (filterLabelEl) filterLabelEl.textContent = 'All Questions';
      applyFilter();
    });

    // Category button listeners
    catBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        catBtns.forEach(b => {
          b.classList.remove('active');
          (b as HTMLElement).style.backgroundColor = '';
          (b as HTMLElement).style.color = '';
        });

        btn.classList.add('active');
        (btn as HTMLElement).style.backgroundColor = 'var(--site-primary, #e2b714)';
        (btn as HTMLElement).style.color = 'var(--site-on-primary, #323437)';

        currentCategory = btn.getAttribute('data-faq-category') || 'all';
        const label = btn.querySelector('span:nth-child(2)')?.textContent || 'All Questions';
        if (filterLabelEl) filterLabelEl.textContent = label;

        applyFilter();
      });
    });

    // Expand/Collapse All
    toggleAllBtn?.addEventListener('click', () => {
      isAllExpanded = !isAllExpanded;
      items.forEach(item => {
        if ((item as HTMLElement).style.display !== 'none') {
          item.open = isAllExpanded;
        }
      });

      if (toggleIcon) toggleIcon.textContent = isAllExpanded ? '🔼' : '🔽';
      if (toggleText) toggleText.textContent = isAllExpanded ? 'Collapse All' : 'Expand All';
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFAQSection);
  } else {
    initFAQSection();
  }
  document.addEventListener('astro:page-load', initFAQSection);
</script>
