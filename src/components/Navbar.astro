---
// Navigation bar following DESIGN.md specifications
---

<header class="sticky top-0 z-50 w-full border-b border-hairline bg-canvas/85 backdrop-blur-md transition-all">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <a href="/" class="group flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-ink text-canvas shadow-level-2 transition-transform duration-200 group-hover:scale-105">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="M6 8h.01"></path>
          <path d="M10 8h.01"></path>
          <path d="M14 8h.01"></path>
          <path d="M18 8h.01"></path>
          <path d="M6 12h.01"></path>
          <path d="M18 12h.01"></path>
          <path d="M8 16h8"></path>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-base font-semibold tracking-tight text-ink">Typing Game Zone</span>
        <span class="text-[10px] font-medium tracking-wide uppercase text-mute font-mono">typinggamezone.com</span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-1 rounded-full border border-hairline bg-canvas-soft px-3 py-1 text-sm font-medium shadow-level-1">
      <a href="/" class="rounded-full px-3.5 py-1.5 text-body transition-colors hover:text-ink hover:bg-canvas">Games (21)</a>
      <a href="/arcade" class="rounded-full px-3.5 py-1.5 text-body transition-colors hover:text-ink hover:bg-canvas">Arcade Lounge</a>
      <a href="/speed-test" class="rounded-full px-3.5 py-1.5 text-body transition-colors hover:text-ink hover:bg-canvas">Speed Test</a>
      <a href="/practice" class="rounded-full px-3.5 py-1.5 text-body transition-colors hover:text-ink hover:bg-canvas">Practice Lab</a>
      <a href="/leaderboards" class="rounded-full px-3.5 py-1.5 text-body transition-colors hover:text-ink hover:bg-canvas">Leaderboards</a>
    </nav>

    <!-- Sound & Quick Controls -->
    <div class="flex items-center gap-3">
      <!-- Sound Switcher Dropdown / Toggle -->
      <div class="relative" id="sound-dropdown-container">
        <button
          id="sound-menu-btn"
          type="button"
          class="flex items-center gap-2 rounded-md border border-hairline bg-canvas px-2.5 py-1.5 text-xs font-mono font-medium text-body shadow-level-1 transition hover:bg-canvas-soft"
          title="Switch Sound Profile"
          aria-expanded="false"
        >
          <span id="sound-icon">🔊</span>
          <span id="current-switch-label" class="hidden sm:inline">Blue Clicky</span>
          <svg class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="sound-menu"
          class="absolute right-0 mt-2 hidden w-48 rounded-lg border border-hairline bg-canvas p-1.5 shadow-level-4 z-50"
        >
          <div class="px-2 py-1 text-[11px] font-mono text-mute uppercase border-b border-hairline mb-1">
            Mechanical Switches
          </div>
          <button data-switch="clicky" class="switch-opt flex w-full items-center justify-between rounded px-2 py-1.5 text-xs text-body hover:bg-canvas-soft hover:text-ink">
            <span>🔵 Blue (Clicky)</span>
            <span class="switch-check text-success hidden">✓</span>
          </button>
          <button data-switch="thock" class="switch-opt flex w-full items-center justify-between rounded px-2 py-1.5 text-xs text-body hover:bg-canvas-soft hover:text-ink">
            <span>🐼 Panda (Thock)</span>
            <span class="switch-check text-success hidden">✓</span>
          </button>
          <button data-switch="linear" class="switch-opt flex w-full items-center justify-between rounded px-2 py-1.5 text-xs text-body hover:bg-canvas-soft hover:text-ink">
            <span>🔴 Red (Linear)</span>
            <span class="switch-check text-success hidden">✓</span>
          </button>
          <button data-switch="typewriter" class="switch-opt flex w-full items-center justify-between rounded px-2 py-1.5 text-xs text-body hover:bg-canvas-soft hover:text-ink">
            <span>📻 Typewriter Bell</span>
            <span class="switch-check text-success hidden">✓</span>
          </button>
          <button data-switch="off" class="switch-opt flex w-full items-center justify-between rounded px-2 py-1.5 text-xs text-body hover:bg-canvas-soft hover:text-ink border-t border-hairline mt-1">
            <span>🔇 Mute Sound</span>
            <span class="switch-check text-success hidden">✓</span>
          </button>
        </div>
      </div>

      <!-- Quick Play Primary CTA -->
      <a
        href="/game/type-defender"
        class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-ink px-4 py-1.5 text-xs font-medium text-on-primary shadow-level-2 transition hover:opacity-90"
      >
        <span>Play Now</span>
        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <!-- Mobile Menu Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden flex h-9 w-9 items-center justify-center rounded-md border border-hairline bg-canvas text-body shadow-level-1"
        aria-label="Toggle navigation"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu-drawer" class="hidden border-b border-hairline bg-canvas px-4 py-3 md:hidden">
    <div class="flex flex-col gap-2 font-medium text-sm">
      <a href="/" class="rounded-md px-3 py-2 text-body hover:bg-canvas-soft hover:text-ink">🎮 All Games (21)</a>
      <a href="/arcade" class="rounded-md px-3 py-2 text-body hover:bg-canvas-soft hover:text-ink">🕹️ Arcade Lounge</a>
      <a href="/speed-test" class="rounded-md px-3 py-2 text-body hover:bg-canvas-soft hover:text-ink">⚡ Speed Test</a>
      <a href="/practice" class="rounded-md px-3 py-2 text-body hover:bg-canvas-soft hover:text-ink">⌨️ Practice Lab</a>
      <a href="/leaderboards" class="rounded-md px-3 py-2 text-body hover:bg-canvas-soft hover:text-ink">🏆 Leaderboards</a>
    </div>
  </div>
</header>

<script>
  import { soundEngine, type SwitchSoundType } from '../lib/soundEngine';

  function initSoundMenu() {
    const btn = document.getElementById('sound-menu-btn');
    const menu = document.getElementById('sound-menu');
    const label = document.getElementById('current-switch-label');
    const icon = document.getElementById('sound-icon');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileDrawer = document.getElementById('mobile-menu-drawer');

    // Mobile nav toggle
    mobileBtn?.addEventListener('click', () => {
      mobileDrawer?.classList.toggle('hidden');
    });

    const updateUI = () => {
      const cur = soundEngine.getSwitch();
      const isMuted = soundEngine.getIsMuted() || cur === 'off';
      if (icon) icon.textContent = isMuted ? '🔇' : '🔊';

      const labels: Record<SwitchSoundType, string> = {
        clicky: 'Blue Clicky',
        thock: 'Panda Thock',
        linear: 'Red Linear',
        typewriter: 'Typewriter',
        off: 'Muted'
      };
      if (label) label.textContent = labels[cur] || 'Sound';

      // Update checkmarks
      document.querySelectorAll('.switch-opt').forEach((el) => {
        const sw = el.getAttribute('data-switch');
        const check = el.querySelector('.switch-check');
        if (check) {
          if (sw === cur) check.classList.remove('hidden');
          else check.classList.add('hidden');
        }
      });
    };

    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      menu?.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!menu?.contains(e.target as Node) && !btn?.contains(e.target as Node)) {
        menu?.classList.add('hidden');
      }
    });

    document.querySelectorAll('.switch-opt').forEach((el) => {
      el.addEventListener('click', () => {
        const sw = el.getAttribute('data-switch') as SwitchSoundType;
        if (sw) {
          soundEngine.setSwitch(sw);
          soundEngine.playKey(false, sw === 'typewriter');
          updateUI();
          menu?.classList.add('hidden');
        }
      });
    });

    updateUI();
  }

  // Run on mount
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSoundMenu);
  } else {
    initSoundMenu();
  }
  document.addEventListener('astro:page-load', initSoundMenu);
</script>
