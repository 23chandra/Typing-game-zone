---
// Navigation bar following DESIGN.md specifications with Global Monkeytype Theme Switcher
import { MONKEYTYPE_THEMES } from '../lib/monkeytypeThemes';
---

<header class="sticky top-0 z-40 w-full border-b border-hairline bg-canvas/90 backdrop-blur-md transition-all select-none">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <a href="/" class="group flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-ink text-on-primary shadow-level-2 transition-transform duration-200 group-hover:scale-105" style="background-color: var(--site-primary, #e2b714); color: var(--site-on-primary, #323437);">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="M6 8h.01"></path>
          <path d="M10 8h.01"></path>
          <path d="M14 8h.01"></path>
          <path d="M18 8h.01"></path>
          <path d="M6 12h.01"></path>
          <path d="M18 12h.01"></path>
          <path d="M8 16h8"></path>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-base font-semibold tracking-tight text-ink">Typing Game Zone</span>
        <span class="text-[10px] font-medium tracking-wide uppercase text-mute font-mono">typinggamezone.com</span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-1 rounded-full border border-hairline bg-canvas-soft px-3 py-1 text-xs font-medium shadow-level-1">
      <a href="/" class="rounded-full px-3 py-1.5 text-body transition-colors hover:text-ink hover:bg-canvas">Games (21)</a>
      <a href="/arcade" class="rounded-full px-3 py-1.5 text-body transition-colors hover:text-ink hover:bg-canvas">Arcade Lounge</a>
      <a href="/speed-test" class="rounded-full px-3 py-1.5 text-body transition-colors hover:text-ink hover:bg-canvas">Speed Test</a>
      <a href="/practice" class="rounded-full px-3 py-1.5 text-body transition-colors hover:text-ink hover:bg-canvas">Practice Lab</a>
      <a href="/leaderboards" class="rounded-full px-3 py-1.5 text-body transition-colors hover:text-ink hover:bg-canvas">Leaderboards</a>
    </nav>

    <!-- Controls: Global Theme Switcher + Sound Switcher + Command Hint + Play CTA -->
    <div class="flex items-center gap-2 sm:gap-3">
      
      <!-- Global Theme Picker Dropdown -->
      <div class="relative" id="nav-theme-container">
        <button
          id="nav-theme-btn"
          type="button"
          class="flex items-center gap-1.5 rounded-xl border border-hairline bg-canvas px-2.5 py-1.5 text-xs font-mono font-medium text-body shadow-level-1 transition hover:text-ink hover:bg-canvas-soft cursor-pointer"
          title="Switch Website Color Theme (17 Monkeytype Themes)"
          aria-expanded="false"
        >
          <span>🎨</span>
          <span id="nav-theme-current-label" class="hidden sm:inline font-bold">Serika Dark</span>
          <svg class="h-3 w-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="nav-theme-menu"
          class="absolute right-0 mt-2 hidden w-72 rounded-2xl border border-hairline bg-canvas p-2.5 shadow-level-4 z-50 font-mono text-xs max-h-[80vh] flex flex-col"
          style="background-color: var(--site-canvas, #2c2e31);"
        >
          <div class="flex items-center justify-between pb-2 mb-2 border-b border-hairline px-1">
            <span class="text-[11px] font-bold text-mute uppercase">Site Theme (17)</span>
            <span class="text-[10px] text-mute">Monkeytype</span>
          </div>

          <!-- Quick Search Filter -->
          <input
            type="text"
            id="nav-theme-search"
            placeholder="Search themes..."
            class="w-full rounded-xl px-3 py-1.5 text-xs border mb-2 focus:outline-none"
            style="background-color: var(--site-canvas-soft, #323437); border-color: var(--site-hairline); color: var(--site-ink);"
          />

          <!-- Themes List -->
          <div id="nav-theme-list" class="overflow-y-auto flex-1 flex flex-col gap-1 pr-1 max-h-60">
            {MONKEYTYPE_THEMES.map(theme => (
              <button
                type="button"
                data-theme-id={theme.id}
                class="nav-theme-opt flex items-center justify-between rounded-xl px-2.5 py-2 text-left transition hover:bg-canvas-soft cursor-pointer"
              >
                <div class="flex flex-col">
                  <span class="font-bold text-xs" style={`color: ${theme.main};`}>{theme.name}</span>
                  <span class="text-[9px] opacity-60 uppercase">{theme.category}</span>
                </div>
                <div class="flex items-center gap-1">
                  <span class="h-2.5 w-2.5 rounded-full" style={`background-color: ${theme.main};`}></span>
                  <span class="h-2.5 w-2.5 rounded-full" style={`background-color: ${theme.sub};`}></span>
                  <span class="h-2.5 w-2.5 rounded-full" style={`background-color: ${theme.text};`}></span>
                  <span class="nav-theme-check ml-1 text-xs font-bold text-success hidden">✓</span>
                </div>
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Sound Switcher Dropdown -->
      <div class="relative" id="sound-dropdown-container">
        <button
          id="sound-menu-btn"
          type="button"
          class="flex items-center gap-1.5 rounded-xl border border-hairline bg-canvas px-2.5 py-1.5 text-xs font-mono font-medium text-body shadow-level-1 transition hover:text-ink hover:bg-canvas-soft cursor-pointer"
          title="Switch Sound Profile"
          aria-expanded="false"
        >
          <span id="sound-icon">🔊</span>
          <span id="current-switch-label" class="hidden lg:inline">Blue Clicky</span>
          <svg class="h-3 w-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="sound-menu"
          class="absolute right-0 mt-2 hidden w-52 rounded-2xl border border-hairline bg-canvas p-1.5 shadow-level-4 z-50 font-mono text-xs"
          style="background-color: var(--site-canvas, #2c2e31);"
        >
          <div class="px-2 py-1 text-[11px] text-mute uppercase border-b border-hairline mb-1">
            Switch Synthesis
          </div>
          <button data-switch="clicky" class="switch-opt flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-body hover:bg-canvas-soft hover:text-ink cursor-pointer">
            <span>🔵 Blue (Clicky)</span>
            <span class="switch-check text-success hidden">✓</span>
          </button>
          <button data-switch="thock" class="switch-opt flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-body hover:bg-canvas-soft hover:text-ink cursor-pointer">
            <span>🐼 Panda (Thock)</span>
            <span class="switch-check text-success hidden">✓</span>
          </button>
          <button data-switch="linear" class="switch-opt flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-body hover:bg-canvas-soft hover:text-ink cursor-pointer">
            <span>🔴 Red (Linear)</span>
            <span class="switch-check text-success hidden">✓</span>
          </button>
          <button data-switch="typewriter" class="switch-opt flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-body hover:bg-canvas-soft hover:text-ink cursor-pointer">
            <span>📻 Typewriter Bell</span>
            <span class="switch-check text-success hidden">✓</span>
          </button>
          <button data-switch="pop" class="switch-opt flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-body hover:bg-canvas-soft hover:text-ink cursor-pointer">
            <span>🫧 Bubble Pop</span>
            <span class="switch-check text-success hidden">✓</span>
          </button>
          <button data-switch="beep" class="switch-opt flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-body hover:bg-canvas-soft hover:text-ink cursor-pointer">
            <span>👾 Digital Beep</span>
            <span class="switch-check text-success hidden">✓</span>
          </button>
          <button data-switch="off" class="switch-opt flex w-full items-center justify-between rounded-xl px-2.5 py-1.5 text-body hover:bg-canvas-soft hover:text-ink border-t border-hairline mt-1 cursor-pointer">
            <span>🔇 Mute Sound</span>
            <span class="switch-check text-success hidden">✓</span>
          </button>
        </div>
      </div>

      <!-- Command Palette Launcher Button -->
      <button
        type="button"
        id="nav-cmd-launcher"
        class="hidden sm:flex items-center gap-1 rounded-xl border border-hairline bg-canvas px-2.5 py-1.5 text-xs font-mono font-medium text-body shadow-level-1 transition hover:text-ink hover:bg-canvas-soft cursor-pointer"
        title="Open Command Palette (Ctrl+K / Esc)"
      >
        <span class="font-bold">>_</span>
        <kbd class="text-[10px] opacity-60">⌘K</kbd>
      </button>

      <!-- Quick Play Primary CTA -->
      <a
        href="/game/type-defender"
        class="hidden sm:inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 text-xs font-medium shadow-level-2 transition hover:opacity-90 active:scale-95"
        style="background-color: var(--site-primary, #e2b714); color: var(--site-on-primary, #323437);"
      >
        <span>Play</span>
        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <!-- Mobile Menu Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden flex h-9 w-9 items-center justify-center rounded-xl border border-hairline bg-canvas text-body shadow-level-1"
        aria-label="Toggle navigation"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu-drawer" class="hidden border-b border-hairline bg-canvas px-4 py-3 md:hidden font-mono text-xs">
    <div class="flex flex-col gap-1.5 font-medium mb-3">
      <a href="/" class="rounded-xl px-3 py-2 text-body hover:bg-canvas-soft hover:text-ink">🎮 All Games (21)</a>
      <a href="/arcade" class="rounded-xl px-3 py-2 text-body hover:bg-canvas-soft hover:text-ink">🕹️ Arcade Lounge</a>
      <a href="/speed-test" class="rounded-xl px-3 py-2 text-body hover:bg-canvas-soft hover:text-ink">⚡ Speed Test</a>
      <a href="/practice" class="rounded-xl px-3 py-2 text-body hover:bg-canvas-soft hover:text-ink">⌨️ Practice Lab</a>
      <a href="/leaderboards" class="rounded-xl px-3 py-2 text-body hover:bg-canvas-soft hover:text-ink">🏆 Leaderboards</a>
    </div>

    <!-- Mobile Command & Theme Quick Action -->
    <div class="pt-2 border-t border-hairline flex items-center justify-between">
      <button
        type="button"
        id="mobile-cmd-btn"
        class="flex items-center gap-1.5 rounded-xl border border-hairline bg-canvas-soft px-3 py-1.5 text-xs font-mono font-bold text-ink"
      >
        <span>>_ Command Palette</span>
      </button>
      <span class="text-[11px] text-mute font-mono">17 Themes</span>
    </div>
  </div>
</header>

<script>
  import { soundEngine, type SwitchSoundType } from '../lib/soundEngine';
  import { MONKEYTYPE_THEMES, applyThemeGlobal, getThemeById, type MonkeytypeTheme } from '../lib/monkeytypeThemes';

  function initNavbar() {
    const soundBtn = document.getElementById('sound-menu-btn');
    const soundMenu = document.getElementById('sound-menu');
    const soundLabel = document.getElementById('current-switch-label');
    const soundIcon = document.getElementById('sound-icon');

    const themeBtn = document.getElementById('nav-theme-btn');
    const themeMenu = document.getElementById('nav-theme-menu');
    const themeLabel = document.getElementById('nav-theme-current-label');
    const themeSearch = document.getElementById('nav-theme-search') as HTMLInputElement | null;
    const themeList = document.getElementById('nav-theme-list');

    const cmdLauncher = document.getElementById('nav-cmd-launcher');
    const mobileCmdBtn = document.getElementById('mobile-cmd-btn');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileDrawer = document.getElementById('mobile-menu-drawer');

    // Mobile nav toggle
    mobileBtn?.addEventListener('click', () => {
      mobileDrawer?.classList.toggle('hidden');
    });

    // Command palette launcher
    const openCmd = () => {
      if ((window as any).toggleGlobalCommandPalette) {
        (window as any).toggleGlobalCommandPalette();
      }
    };
    cmdLauncher?.addEventListener('click', openCmd);
    mobileCmdBtn?.addEventListener('click', () => {
      mobileDrawer?.classList.add('hidden');
      openCmd();
    });

    // --- SOUND ENGINE UI SYNC ---
    const updateSoundUI = () => {
      const cur = soundEngine.getSwitch();
      const isMuted = soundEngine.getIsMuted() || cur === 'off';
      if (soundIcon) soundIcon.textContent = isMuted ? '🔇' : '🔊';

      const labels: Record<SwitchSoundType, string> = {
        clicky: 'Blue Clicky',
        thock: 'Panda Thock',
        linear: 'Red Linear',
        typewriter: 'Typewriter',
        pop: 'Bubble Pop',
        beep: 'Digital Beep',
        off: 'Muted'
      };
      if (soundLabel) soundLabel.textContent = labels[cur] || 'Sound';

      // Update checkmarks
      document.querySelectorAll('.switch-opt').forEach((el) => {
        const sw = el.getAttribute('data-switch');
        const check = el.querySelector('.switch-check');
        if (check) {
          if (sw === cur) check.classList.remove('hidden');
          else check.classList.add('hidden');
        }
      });
    };

    soundBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      themeMenu?.classList.add('hidden');
      soundMenu?.classList.toggle('hidden');
    });

    document.querySelectorAll('.switch-opt').forEach((el) => {
      el.addEventListener('click', () => {
        const sw = el.getAttribute('data-switch') as SwitchSoundType;
        if (sw) {
          soundEngine.setSwitch(sw);
          soundEngine.playKey(false, sw === 'typewriter');
          updateSoundUI();
          soundMenu?.classList.add('hidden');
        }
      });
    });

    // --- THEME ENGINE UI SYNC ---
    const updateThemeUI = (theme?: MonkeytypeTheme) => {
      const curId = theme ? theme.id : (localStorage.getItem('monkeytype_theme') || 'serika_dark');
      const curTheme = theme || getThemeById(curId);

      if (themeLabel) themeLabel.textContent = curTheme.name;

      // Update active checkmarks
      document.querySelectorAll('.nav-theme-opt').forEach((el) => {
        const tId = el.getAttribute('data-theme-id');
        const check = el.querySelector('.nav-theme-check');
        if (check) {
          if (tId === curId) {
            check.classList.remove('hidden');
            el.classList.add('font-bold');
          } else {
            check.classList.add('hidden');
            el.classList.remove('font-bold');
          }
        }
      });
    };

    themeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      soundMenu?.classList.add('hidden');
      themeMenu?.classList.toggle('hidden');
      if (!themeMenu?.classList.contains('hidden')) {
        themeSearch?.focus();
      }
    });

    themeSearch?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
      document.querySelectorAll('.nav-theme-opt').forEach((el) => {
        const tId = el.getAttribute('data-theme-id') || '';
        const themeObj = getThemeById(tId);
        const match = themeObj.name.toLowerCase().includes(q) || themeObj.id.toLowerCase().includes(q) || themeObj.category.toLowerCase().includes(q);
        (el as HTMLElement).style.display = match ? 'flex' : 'none';
      });
    });

    document.querySelectorAll('.nav-theme-opt').forEach((el) => {
      el.addEventListener('click', () => {
        const tId = el.getAttribute('data-theme-id');
        if (tId) {
          const selectedTheme = getThemeById(tId);
          applyThemeGlobal(selectedTheme);
          updateThemeUI(selectedTheme);
          themeMenu?.classList.add('hidden');
        }
      });
    });

    // Listen to global theme change event
    window.addEventListener('monkeytype:theme-change', (e: any) => {
      updateThemeUI(e.detail);
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!soundMenu?.contains(e.target as Node) && !soundBtn?.contains(e.target as Node)) {
        soundMenu?.classList.add('hidden');
      }
      if (!themeMenu?.contains(e.target as Node) && !themeBtn?.contains(e.target as Node)) {
        themeMenu?.classList.add('hidden');
      }
    });

    updateSoundUI();
    updateThemeUI();
  }

  // Run on mount
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavbar);
  } else {
    initNavbar();
  }
  document.addEventListener('astro:page-load', initNavbar);
</script>
