<style>
  @keyframes caret-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.15; }
  }
  .caret-idle {
    animation: caret-pulse 1s infinite ease-in-out;
  }
</style>

<script>
  import {
    MONKEYTYPE_CODE_SNIPPETS,
    generateMonkeytypeWordList,
    getMonkeytypeQuote
  } from '../lib/wordLists';
  import { MONKEYTYPE_THEMES, getThemeById, applyThemeToElement, applyThemeGlobal, type MonkeytypeTheme } from '../lib/monkeytypeThemes';
  import { soundEngine, type SwitchSoundType } from '../lib/soundEngine';
  import { storage } from '../lib/storage';
  import { transliterateInput, isNativeScriptSupported, applySmartAccents } from '../lib/transliterationEngine';
  import { KEY_LABEL_OVERRIDES } from '../lib/fingerMapping';
  import confetti from 'canvas-confetti';

  interface KeystrokeEvent {
    char: string;
    expected: string;
    isCorrect: boolean;
    timestamp: number;
    wordIdx: number;
    charIdx: number;
  }

  interface TrajectoryPoint {
    second: number;
    wpm: number;
    rawWpm: number;
    errors: number;
  }

  let activeSpeedTestTimer: number | null = null;
  let activeCleanups: (() => void)[] = [];

  function initMonkeytypeEngine() {
    // 1. Cleanup old active timers / listeners
    if (activeSpeedTestTimer) {
      clearInterval(activeSpeedTestTimer);
      activeSpeedTestTimer = null;
    }
    activeCleanups.forEach(c => c());
    activeCleanups = [];

    const rootEl = document.getElementById('monkeytype-root');
    if (!rootEl) return;

    // 2. DOM Elements
    const wordsViewport = document.getElementById('mt-words-viewport');
    const wordsWrapper = document.getElementById('mt-words-wrapper');
    const caret = document.getElementById('mt-caret');
    const inputEl = document.getElementById('mt-unified-input') as HTMLInputElement | null;
    const liveCounter = document.getElementById('mt-live-counter');
    const liveWpmPill = document.getElementById('mt-live-wpm-pill');
    const liveWpm = document.getElementById('mt-live-wpm');
    const liveAcc = document.getElementById('mt-live-acc');
    const focusOverlay = document.getElementById('mt-focus-overlay');
    const capsWarning = document.getElementById('mt-caps-warning');
    const configBar = document.getElementById('mt-config-bar');
    const typingView = document.getElementById('mt-typing-view');
    const resultView = document.getElementById('mt-result-view');
    const quoteAuthorEl = document.getElementById('mt-quote-author');
    const zenFinishBtn = document.getElementById('mt-zen-finish-btn');
    const masterFailOverlay = document.getElementById('mt-master-fail-overlay');
    const masterRestartBtn = document.getElementById('mt-master-restart-btn');

    // Modifiers & Options
    const togglePuncBtn = document.getElementById('mt-toggle-punc');
    const toggleNumBtn = document.getElementById('mt-toggle-num');
    const subContainer = document.getElementById('mt-sub-container');
    const restartBtn = document.getElementById('mt-restart-btn');
    const cmdHintBtn = document.getElementById('mt-cmd-hint-btn');

    // Settings Elements
    const soundCycleBtn = document.getElementById('mt-sound-cycle-btn');
    const soundIcon = document.getElementById('mt-sound-icon');
    const soundLabel = document.getElementById('mt-sound-label');
    const caretCycleBtn = document.getElementById('mt-caret-cycle-btn');
    const caretLabel = document.getElementById('mt-caret-label');
    const ghostCycleBtn = document.getElementById('mt-ghost-cycle-btn');
    const ghostLabel = document.getElementById('mt-ghost-label');
    const ghostCaret = document.getElementById('mt-ghost-caret');
    const ghostTag = document.getElementById('mt-ghost-tag');

    // Modals
    const customModal = document.getElementById('mt-custom-modal');
    const customCloseBtn = document.getElementById('mt-custom-close-btn');
    const customCancelBtn = document.getElementById('mt-custom-cancel-btn');
    const customSaveBtn = document.getElementById('mt-custom-save-btn');
    const customValInput = document.getElementById('mt-custom-val-input') as HTMLInputElement | null;

    const customTextModal = document.getElementById('mt-custom-text-modal');
    const customTextCloseBtn = document.getElementById('mt-custom-text-close-btn');
    const customTextCancelBtn = document.getElementById('mt-custom-text-cancel-btn');
    const customTextSaveBtn = document.getElementById('mt-custom-text-save-btn');
    const customTextarea = document.getElementById('mt-custom-textarea') as HTMLTextAreaElement | null;

    const cmdPalette = document.getElementById('mt-cmd-palette');
    const cmdSearch = document.getElementById('mt-cmd-search') as HTMLInputElement | null;
    const cmdList = document.getElementById('mt-cmd-list');

    // Result Elements
    const resWpm = document.getElementById('mt-res-wpm');
    const resRaw = document.getElementById('mt-res-raw');
    const resAcc = document.getElementById('mt-res-acc');
    const resConsistency = document.getElementById('mt-res-consistency');
    const resTestType = document.getElementById('mt-res-test-type');
    const resChars = document.getElementById('mt-res-chars');
    const resTime = document.getElementById('mt-res-time');
    const pbBadge = document.getElementById('mt-pb-badge');
    const ghostBadge = document.getElementById('mt-ghost-badge');
    const ghostBadgeText = document.getElementById('mt-ghost-badge-text');
    const xpBadge = document.getElementById('mt-xp-badge');
    const xpBadgeText = document.getElementById('mt-xp-badge-text');
    const resNextBtn = document.getElementById('mt-res-next-btn');
    const resRepeatBtn = document.getElementById('mt-res-repeat-btn');
    const resPracticeMissedBtn = document.getElementById('mt-res-practice-missed-btn');
    const missedCountEl = document.getElementById('mt-missed-count');
    const resReplayBtn = document.getElementById('mt-res-replay-btn');
    const resShareBtn = document.getElementById('mt-res-share-btn');
    const shareLabel = document.getElementById('mt-share-label');
    const chartCanvas = document.getElementById('mt-chart-canvas') as HTMLCanvasElement | null;
    const chartTooltip = document.getElementById('mt-chart-tooltip');

    // Replay Modal
    const replayModal = document.getElementById('mt-replay-modal');
    const replayCloseBtn = document.getElementById('mt-replay-close-btn');
    const replayWordsWrapper = document.getElementById('mt-replay-words-wrapper');
    const replayPlayBtn = document.getElementById('mt-replay-play-btn');
    const replayTime = document.getElementById('mt-replay-time');

    // Pool Selector
    const poolBtn = document.getElementById('mt-pool-btn');
    const poolMenu = document.getElementById('mt-pool-menu');
    const poolLabel = document.getElementById('mt-pool-label');

    // Script Mode Toggle & Phonetic IME
    const scriptToggleWrapper = document.getElementById('mt-script-toggle-wrapper');
    const scriptNativeBtn = document.getElementById('mt-script-native-btn');
    const scriptLatinBtn = document.getElementById('mt-script-latin-btn');
    const phoneticBadge = document.getElementById('mt-phonetic-badge');

    if (!wordsViewport || !wordsWrapper || !inputEl) return;

    // 3. State Management
    let currentTheme: MonkeytypeTheme = getThemeById(localStorage.getItem('monkeytype_theme') || 'serika_dark');
    let mode: 'time' | 'words' | 'quote' | 'zen' | 'custom' = 'time';
    let subOption: number = 30; // default 30s
    let quoteLength: 'all' | 'short' | 'medium' | 'long' | 'thicc' = 'all';
    let wordPool: string = 'english';
    let scriptMode: 'native' | 'latin' = 'native';
    let currentLatinBuffer = '';
    let includePunc = false;
    let includeNum = false;
    let caretStyle: 'line' | 'block' | 'underline' | 'outline' | 'carrot' = (localStorage.getItem('monkeytype_caret') as any) || 'line';
    let ghostMode: 'off' | 'pb' | '60' | '80' | '100' | '120' = (localStorage.getItem('mt_ghost_mode') as any) || 'off';
    let masterMode = false;
    let confidenceMode = false;
    let blindMode = false;
    let customTextBuffer = '';

    // Active Test Runtime State
    let words: string[] = [];
    let currentWordIndex = 0;
    let currentCharIndex = 0;
    let correctChars = 0;
    let errorChars = 0;
    let extraCharsCount = 0;
    let missedCharsCount = 0;
    let totalKeystrokes = 0;
    let startTime: number = 0;
    let timeRemaining = 30;
    let isTestRunning = false;
    let isTestComplete = false;
    let wordCharStates: (boolean | null)[][] = [];
    let trajectory: TrajectoryPoint[] = [];
    let keystrokeLog: KeystrokeEvent[] = [];
    let missedWordsSet: Set<string> = new Set();
    let isReplayingMissed = false;

    // Deduplication tracker
    let lastKeyProcessedTime = 0;
    let lastKeyProcessed = '';

    // 4. Apply Initial Theme & Sync with Site-wide Theming
    const applyCurrentTheme = (theme: MonkeytypeTheme) => {
      currentTheme = theme;
      applyThemeGlobal(theme);
      applyThemeToElement(rootEl, theme);
      updateCaretAppearance();
      if (isTestComplete && trajectory.length > 0) drawSplineChart(trajectory);
    };

    // Listen for site-wide theme changes from Navbar, Footer, or Command Palette
    const onSiteThemeChange = (e: any) => {
      if (e.detail) {
        currentTheme = e.detail;
        applyThemeToElement(rootEl, currentTheme);
        updateCaretAppearance();
        if (isTestComplete && trajectory.length > 0) drawSplineChart(trajectory);
      }
    };
    window.addEventListener('monkeytype:theme-change', onSiteThemeChange);
    activeCleanups.push(() => window.removeEventListener('monkeytype:theme-change', onSiteThemeChange));

    applyCurrentTheme(currentTheme);

    // 5. Caret Appearance
    function updateCaretAppearance() {
      if (!caret) return;
      caret.className = `absolute top-0 left-0 transition-all duration-75 ease-out pointer-events-none z-20 caret-${caretStyle} caret-idle`;
      if (caretLabel) caretLabel.textContent = caretStyle;

      switch (caretStyle) {
        case 'line':
          caret.style.width = '2.5px';
          caret.style.borderRadius = '9999px';
          caret.style.backgroundColor = 'var(--mt-caret)';
          break;
        case 'block':
          caret.style.width = '1.2ch';
          caret.style.borderRadius = '2px';
          caret.style.backgroundColor = 'var(--mt-caret)';
          caret.style.opacity = '0.5';
          break;
        case 'underline':
          caret.style.width = '1.2ch';
          caret.style.height = '3px';
          caret.style.borderRadius = '9999px';
          caret.style.backgroundColor = 'var(--mt-caret)';
          break;
        case 'outline':
          caret.style.width = '1.2ch';
          caret.style.borderRadius = '3px';
          caret.style.border = '2px solid var(--mt-caret)';
          caret.style.backgroundColor = 'transparent';
          break;
        case 'carrot':
          caret.style.width = 'auto';
          caret.style.height = 'auto';
          caret.style.backgroundColor = 'transparent';
          caret.textContent = '🥕';
          caret.style.fontSize = '1rem';
          break;
      }
    }
    updateCaretAppearance();

    // Ghost Racer UI & Cycling
    const updateGhostUI = () => {
      if (ghostLabel) ghostLabel.textContent = `ghost: ${ghostMode}`;
      if (ghostCycleBtn) {
        if (ghostMode === 'off') {
          ghostCycleBtn.style.opacity = '0.6';
          ghostCycleBtn.style.color = 'var(--mt-sub)';
        } else {
          ghostCycleBtn.style.opacity = '1';
          ghostCycleBtn.style.color = 'var(--mt-main)';
          ghostCycleBtn.style.fontWeight = 'bold';
        }
      }
      if (ghostCaret) {
        if (ghostMode === 'off' || !isTestRunning) ghostCaret.classList.add('hidden');
        else ghostCaret.classList.remove('hidden');
      }
    };
    updateGhostUI();

    ghostCycleBtn?.addEventListener('click', () => {
      const modes: ('off' | 'pb' | '60' | '80' | '100' | '120')[] = ['off', 'pb', '60', '80', '100', '120'];
      const nextIdx = (modes.indexOf(ghostMode) + 1) % modes.length;
      ghostMode = modes[nextIdx];
      localStorage.setItem('mt_ghost_mode', ghostMode);
      updateGhostUI();
    });

    function updateGhostCaret(elapsedSec: number) {
      if (ghostMode === 'off' || !ghostCaret || !wordsWrapper) {
        if (ghostCaret) ghostCaret.classList.add('hidden');
        return;
      }

      ghostCaret.classList.remove('hidden');

      const profile = storage.getProfile();
      let targetWpm = 60;
      if (ghostMode === 'pb') {
        targetWpm = profile.ghostPB?.wpm || profile.bestWPM || 60;
      } else {
        targetWpm = parseInt(ghostMode, 10) || 60;
      }

      if (ghostTag) {
        ghostTag.textContent = `👻 ${ghostMode === 'pb' ? 'PB ' : ''}${targetWpm}`;
      }

      // Calculate target character advancement
      const ghostCharsTotal = Math.floor((elapsedSec * (targetWpm * 5)) / 60);

      let charCount = 0;
      let targetWordEl: HTMLElement | null = null;
      let targetLetterEl: HTMLElement | null = null;

      const wordDivs = wordsWrapper.querySelectorAll('.mt-word') as NodeListOf<HTMLElement>;
      for (let i = 0; i < wordDivs.length; i++) {
        const wDiv = wordDivs[i];
        const letters = wDiv.querySelectorAll('.mt-letter:not(.extra-char)') as NodeListOf<HTMLElement>;
        const wLen = letters.length + 1; // including space

        if (charCount + wLen > ghostCharsTotal || i === wordDivs.length - 1) {
          targetWordEl = wDiv;
          const charWithinWord = Math.max(0, ghostCharsTotal - charCount);
          if (charWithinWord < letters.length) {
            targetLetterEl = letters[charWithinWord];
          } else if (letters.length > 0) {
            targetLetterEl = letters[letters.length - 1];
          }
          break;
        }
        charCount += wLen;
      }

      if (targetWordEl) {
        let gx = targetWordEl.offsetLeft;
        let gy = targetWordEl.offsetTop;
        if (targetLetterEl) {
          gx = targetLetterEl.offsetLeft;
          gy = targetLetterEl.offsetTop;
        }
        ghostCaret.style.transform = `translate(${gx}px, ${gy + 4}px)`;
      }
    }

    // Helper to safely focus input without jumping/scrolling the window
    const focusInputSafely = () => {
      try {
        inputEl?.focus({ preventScroll: true });
      } catch {
        inputEl?.focus();
      }
    };

    // 6. Sound Switcher Sync
    const updateSoundUI = () => {
      const cur = soundEngine.getSwitch();
      const isMuted = soundEngine.getIsMuted() || cur === 'off';
      if (soundIcon) soundIcon.textContent = isMuted ? '🔇' : '🔊';
      if (soundLabel) soundLabel.textContent = cur;
    };
    updateSoundUI();

    const onGlobalSoundChange = () => {
      updateSoundUI();
    };
    window.addEventListener('typing:sound-change', onGlobalSoundChange);
    activeCleanups.push(() => window.removeEventListener('typing:sound-change', onGlobalSoundChange));

    // 7. Word Generation
    function generateWords() {
      missedWordsSet.clear();
      isTestRunning = false;
      isTestComplete = false;
      currentWordIndex = 0;
      currentCharIndex = 0;
      currentLatinBuffer = '';
      correctChars = 0;
      errorChars = 0;
      extraCharsCount = 0;
      missedCharsCount = 0;
      totalKeystrokes = 0;
      trajectory = [];
      keystrokeLog = [];

      if (activeSpeedTestTimer) {
        clearInterval(activeSpeedTestTimer);
        activeSpeedTestTimer = null;
      }

      masterFailOverlay?.classList.add('hidden');
      resultView?.classList.add('hidden');
      typingView?.classList.remove('hidden');
      configBar?.classList.remove('opacity-15');

      if (isReplayingMissed) {
        isReplayingMissed = false;
      } else if (mode === 'quote') {
        const q = getMonkeytypeQuote(quoteLength);
        words = q.text.trim().split(/\s+/);
        if (quoteAuthorEl) {
          quoteAuthorEl.textContent = `— ${q.author}`;
          quoteAuthorEl.classList.remove('hidden');
        }
      } else if (wordPool === 'code') {
        const c = MONKEYTYPE_CODE_SNIPPETS[Math.floor(Math.random() * MONKEYTYPE_CODE_SNIPPETS.length)];
        words = c.code.replace(/\r\n/g, '\n').split('\n').flatMap((line, idx, arr) => {
          const lineWords = line.trim().split(/\s+/).filter(Boolean);
          if (idx < arr.length - 1) lineWords.push('↵');
          return lineWords;
        }).filter(Boolean);
        if (quoteAuthorEl) quoteAuthorEl.classList.add('hidden');
      } else if (mode === 'custom') {
        if (!customTextBuffer) customTextBuffer = 'The quick brown fox jumps over the lazy dog.';
        words = customTextBuffer.trim().split(/\s+/).filter(Boolean);
        if (quoteAuthorEl) quoteAuthorEl.classList.add('hidden');
      } else if (mode === 'zen') {
        words = generateMonkeytypeWordList(100, wordPool, includePunc, includeNum, wordPool, scriptMode);
        if (quoteAuthorEl) quoteAuthorEl.classList.add('hidden');
      } else {
        const count = mode === 'words' ? subOption : Math.max(120, subOption * 4);
        words = generateMonkeytypeWordList(count, wordPool, includePunc, includeNum, wordPool, scriptMode);
        if (quoteAuthorEl) quoteAuthorEl.classList.add('hidden');
      }

      wordCharStates = words.map(w => new Array(w.length).fill(null));
      timeRemaining = mode === 'time' ? subOption : 0;

      if (liveCounter) {
        if (mode === 'time') liveCounter.textContent = `${subOption}`;
        else if (mode === 'words') liveCounter.textContent = `0 / ${subOption}`;
        else if (mode === 'zen') liveCounter.textContent = `zen`;
        else liveCounter.textContent = `${words.length}w`;
      }

      if (liveWpmPill) liveWpmPill.classList.add('opacity-0');
      if (zenFinishBtn) {
        if (mode === 'zen') zenFinishBtn.classList.remove('hidden');
        else zenFinishBtn.classList.add('hidden');
      }

      renderWordsDOM();
      requestAnimationFrame(() => {
        positionCaret();
        if (window.location.pathname.startsWith('/speed-test')) {
          focusInputSafely();
        }
      });
    }

    // 8. Render Words DOM (Exact Monkeytype Letter structure)
    function renderWordsDOM() {
      if (!wordsWrapper) return;
      const caretEl = caret;
      const ghostEl = ghostCaret;
      wordsWrapper.innerHTML = '';
      if (caretEl) wordsWrapper.appendChild(caretEl);
      if (ghostEl) wordsWrapper.appendChild(ghostEl);
      wordsWrapper.style.transform = 'translateY(0px)';

      words.forEach((w, wIdx) => {
        const wordDiv = document.createElement('div');
        wordDiv.className = `mt-word inline-block mr-3 mb-1.5 transition-colors duration-150 ${wIdx === currentWordIndex ? 'active-word' : ''}`;
        wordDiv.setAttribute('data-word-idx', `${wIdx}`);

        w.split('').forEach((ch, cIdx) => {
          const letterSpan = document.createElement('span');
          letterSpan.textContent = ch;
          letterSpan.className = 'mt-letter transition-colors';
          letterSpan.setAttribute('data-char-idx', `${cIdx}`);
          letterSpan.style.color = 'var(--mt-sub)';
          wordDiv.appendChild(letterSpan);
        });

        wordsWrapper.appendChild(wordDiv);
      });
    }

    // 9. Gliding Smooth Caret Positioning & True Line Jumping
    function positionCaret() {
      if (!caret || !wordsWrapper || isTestComplete) {
        if (caret) caret.style.opacity = '0';
        return;
      }

      const activeWordDiv = wordsWrapper.querySelector(`[data-word-idx="${currentWordIndex}"]`) as HTMLElement | null;
      if (!activeWordDiv) {
        caret.style.opacity = '0';
        return;
      }

      const letters = activeWordDiv.querySelectorAll('.mt-letter:not(.extra-char)') as NodeListOf<HTMLElement>;
      let targetX = activeWordDiv.offsetLeft;
      let targetY = activeWordDiv.offsetTop;
      const targetH = activeWordDiv.offsetHeight || 38;

      if (currentCharIndex < letters.length) {
        const activeLetter = letters[currentCharIndex];
        targetX = activeLetter.offsetLeft;
        targetY = activeLetter.offsetTop;
      } else if (letters.length > 0) {
        const lastLetter = letters[letters.length - 1];
        targetX = lastLetter.offsetLeft + lastLetter.offsetWidth;
        targetY = lastLetter.offsetTop;
      }

      // Smooth caret translation
      caret.style.transform = `translate(${targetX}px, ${targetY + 4}px)`;
      if (caretStyle === 'line' || caretStyle === 'block' || caretStyle === 'outline') {
        caret.style.height = `${targetH - 8}px`;
      }
      caret.style.opacity = '1';

      // Line scrolling:
      // When current line is line 2 or more, shift container up by 1 line height
      const singleLineHeight = targetH || 40;
      const scrollOffset = Math.max(0, activeWordDiv.offsetTop - singleLineHeight);
      wordsWrapper.style.transform = `translateY(-${scrollOffset}px)`;
    }

    // 10. Start Test Timer
    function startTest() {
      if (isTestRunning) return;
      isTestRunning = true;
      startTime = Date.now();
      trajectory = [{ second: 0, wpm: 0, rawWpm: 0, errors: 0 }];

      configBar?.classList.add('opacity-15');
      if (liveWpmPill) liveWpmPill.classList.remove('opacity-0');

      if (ghostMode !== 'off' && ghostCaret) {
        ghostCaret.classList.remove('hidden');
        updateGhostCaret(0);
      }

      if (activeSpeedTestTimer) clearInterval(activeSpeedTestTimer);

      activeSpeedTestTimer = window.setInterval(() => {
        const elapsedSec = (Date.now() - startTime) / 1000;
        const minutes = Math.max(0.016, elapsedSec / 60);

        const grossWpm = Math.round((totalKeystrokes / 5) / minutes) || 0;
        const netWpm = Math.max(0, Math.round(((correctChars - errorChars) / 5) / minutes)) || 0;
        const acc = totalKeystrokes > 0 ? Math.round((correctChars / totalKeystrokes) * 100) : 100;

        trajectory.push({
          second: Math.round(elapsedSec),
          wpm: netWpm,
          rawWpm: grossWpm,
          errors: errorChars
        });

        if (liveWpm) liveWpm.textContent = `${netWpm}`;
        if (liveAcc) liveAcc.textContent = `${acc}%`;

        // Update Ghost Racer movement
        updateGhostCaret(elapsedSec);

        if (mode === 'time') {
          timeRemaining = Math.max(0, subOption - Math.floor(elapsedSec));
          if (liveCounter) liveCounter.textContent = `${timeRemaining}`;

          if (timeRemaining <= 0) {
            finishTest();
            return;
          }
        } else if (mode === 'words') {
          if (liveCounter) liveCounter.textContent = `${currentWordIndex} / ${subOption}`;
        } else if (mode === 'zen') {
          if (liveCounter) liveCounter.textContent = `${Math.floor(elapsedSec)}s`;
        } else {
          if (liveCounter) liveCounter.textContent = `${Math.floor(elapsedSec)}s`;
        }
      }, 500);
    }

    // 11. Finish Test & Diagnostics
    function finishTest() {
      if (activeSpeedTestTimer) {
        clearInterval(activeSpeedTestTimer);
        activeSpeedTestTimer = null;
      }
      isTestRunning = false;
      isTestComplete = true;
      if (caret) caret.style.opacity = '0';
      if (ghostCaret) ghostCaret.classList.add('hidden');
      configBar?.classList.remove('opacity-15');

      const elapsedSec = mode === 'time' ? subOption : Math.max(1, (Date.now() - startTime) / 1000);
      const minutes = elapsedSec / 60;
      const rawWpmVal = Math.round((totalKeystrokes / 5) / minutes) || 0;
      const netWpmVal = Math.max(0, Math.round(((correctChars - errorChars) / 5) / minutes)) || 0;
      const accuracyVal = totalKeystrokes > 0 ? Math.round((correctChars / totalKeystrokes) * 100) : 100;

      // Consistency formula
      let consistency = 92;
      if (trajectory.length > 3) {
        const wpms = trajectory.slice(1).map(t => t.wpm);
        const mean = Math.max(1, wpms.reduce((a, b) => a + b, 0) / wpms.length);
        const variance = wpms.reduce((a, b) => a + Math.pow(b - mean, 2), 0) / wpms.length;
        const stdDev = Math.sqrt(variance);
        const cv = (stdDev / mean) * 100;
        consistency = Math.max(40, Math.min(99, Math.round(100 - cv)));
      }

      // Populate Result Hero
      if (resWpm) resWpm.textContent = `${netWpmVal}`;
      if (resRaw) resRaw.textContent = `${rawWpmVal}`;
      if (resAcc) resAcc.textContent = `${accuracyVal}%`;
      if (resConsistency) resConsistency.textContent = `${consistency}%`;
      if (resTestType) resTestType.textContent = `${mode} ${mode === 'time' ? subOption + 's' : mode === 'words' ? subOption + 'w' : ''} • ${wordPool} ${includePunc ? '• punc' : ''} ${includeNum ? '• num' : ''}`;
      if (resChars) resChars.textContent = `${correctChars} / ${errorChars} / ${extraCharsCount} / ${missedCharsCount}`;
      if (resTime) resTime.textContent = `${Math.round(elapsedSec)}s`;

      // Save to Storage & Record Activities
      const recResult = storage.recordGameResult('speed-test', netWpmVal * 10, netWpmVal, accuracyVal, 1, currentWordIndex, totalKeystrokes, errorChars);
      storage.saveGhostPB(netWpmVal, mode, elapsedSec);

      if (pbBadge) {
        if (recResult.newBestWPM || recResult.newHighScore) {
          pbBadge.classList.remove('hidden');
          pbBadge.classList.add('flex');
        } else {
          pbBadge.classList.add('hidden');
          pbBadge.classList.remove('flex');
        }
      }

      // Ghost Duel Outcome Badge
      if (ghostMode !== 'off' && ghostBadge && ghostBadgeText) {
        const profile = storage.getProfile();
        const targetGhostWPM = ghostMode === 'pb' ? (profile.ghostPB?.wpm || profile.bestWPM || 60) : parseInt(ghostMode, 10) || 60;
        const won = netWpmVal >= targetGhostWPM;
        ghostBadge.classList.remove('hidden');
        ghostBadge.classList.add('flex');
        if (won) {
          ghostBadgeText.textContent = `👻 Beat Ghost (${netWpmVal} vs ${targetGhostWPM} WPM)!`;
          ghostBadge.style.color = 'var(--site-success, #10b981)';
        } else {
          ghostBadgeText.textContent = `👻 Ghost Ahead (${targetGhostWPM} WPM)`;
          ghostBadge.style.color = 'var(--mt-sub)';
        }
      } else if (ghostBadge) {
        ghostBadge.classList.add('hidden');
      }

      // XP Telemetry Badge
      if (xpBadge && xpBadgeText && recResult.xpEarned) {
        xpBadge.classList.remove('hidden');
        xpBadge.classList.add('flex');
        const lvlInfo = storage.getLevelInfo(storage.getProfile().xp);
        xpBadgeText.textContent = `+${recResult.xpEarned} XP • Lvl ${lvlInfo.level} (${lvlInfo.progressPercent}%)`;
      }

      // Missed words button toggle
      if (resPracticeMissedBtn && missedCountEl) {
        if (missedWordsSet.size > 0) {
          missedCountEl.textContent = `${missedWordsSet.size}`;
          resPracticeMissedBtn.classList.remove('hidden');
          resPracticeMissedBtn.classList.add('inline-flex');
        } else {
          resPracticeMissedBtn.classList.add('hidden');
          resPracticeMissedBtn.classList.remove('inline-flex');
        }
      }

      typingView?.classList.add('hidden');
      resultView?.classList.remove('hidden');

      soundEngine.playVictory();
      if (netWpmVal >= 50) {
        try {
          confetti({ particleCount: 90, spread: 70, origin: { y: 0.6 } });
        } catch {}
      }

      // Draw Spline Chart
      drawSplineChart(trajectory);
    }

    // 12. Spline Velocity Chart Drawing with Hover Tooltip
    function drawSplineChart(data: TrajectoryPoint[]) {
      if (!chartCanvas) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = chartCanvas.getBoundingClientRect();
      const w = Math.max(300, Math.floor(rect.width || 600));
      const h = Math.max(120, Math.floor(rect.height || 180));

      chartCanvas.width = Math.round(w * dpr);
      chartCanvas.height = Math.round(h * dpr);
      const ctx = chartCanvas.getContext('2d');
      if (!ctx) return;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);

      const chartData = data.length > 1 ? data : [
        { second: 0, wpm: 0, rawWpm: 0, errors: 0 },
        { second: 1, wpm: data[0]?.wpm || 30, rawWpm: data[0]?.rawWpm || 30, errors: 0 }
      ];

      const padX = 35;
      const padY = 20;
      const graphW = w - padX * 2;
      const graphH = h - padY * 2;

      const maxWpm = Math.max(50, ...chartData.map(d => Math.max(d.wpm, d.rawWpm))) * 1.15;

      // Background grid lines
      ctx.strokeStyle = currentTheme.sub;
      ctx.globalAlpha = 0.15;
      ctx.lineWidth = 1;
      ctx.setLineDash([4, 4]);

      [0.25, 0.5, 0.75, 1.0].forEach(p => {
        const gy = padY + graphH * (1 - p);
        ctx.beginPath();
        ctx.moveTo(padX, gy);
        ctx.lineTo(w - padX, gy);
        ctx.stroke();

        ctx.globalAlpha = 0.5;
        ctx.font = '10px monospace';
        ctx.fillStyle = currentTheme.sub;
        ctx.fillText(`${Math.round(maxWpm * p)}`, 6, gy + 3);
        ctx.globalAlpha = 0.15;
      });
      ctx.setLineDash([]);
      ctx.globalAlpha = 1.0;

      const points = chartData.map((d, i) => ({
        x: padX + (i / (chartData.length - 1)) * graphW,
        y: padY + graphH * (1 - d.wpm / maxWpm),
        rawY: padY + graphH * (1 - d.rawWpm / maxWpm),
        data: d
      }));

      // Raw WPM dotted curve
      ctx.strokeStyle = currentTheme.sub;
      ctx.lineWidth = 1.5;
      ctx.globalAlpha = 0.6;
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      for (let i = 0; i < points.length; i++) {
        if (i === 0) ctx.moveTo(points[i].x, points[i].rawY);
        else {
          const xc = (points[i].x + points[i - 1].x) / 2;
          const yc = (points[i].rawY + points[i - 1].rawY) / 2;
          ctx.quadraticCurveTo(points[i - 1].x, points[i - 1].rawY, xc, yc);
        }
      }
      ctx.lineTo(points[points.length - 1].x, points[points.length - 1].rawY);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.globalAlpha = 1.0;

      // Area gradient under Net WPM curve
      const grad = ctx.createLinearGradient(0, padY, 0, padY + graphH);
      grad.addColorStop(0, currentTheme.main + '44');
      grad.addColorStop(1, currentTheme.main + '00');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.moveTo(points[0].x, padY + graphH);
      for (let i = 0; i < points.length; i++) {
        if (i === 0) ctx.lineTo(points[i].x, points[i].y);
        else {
          const xc = (points[i].x + points[i - 1].x) / 2;
          const yc = (points[i].y + points[i - 1].y) / 2;
          ctx.quadraticCurveTo(points[i - 1].x, points[i - 1].y, xc, yc);
        }
      }
      ctx.lineTo(points[points.length - 1].x, points[points.length - 1].y);
      ctx.lineTo(points[points.length - 1].x, padY + graphH);
      ctx.closePath();
      ctx.fill();

      // Net WPM stroke line
      ctx.strokeStyle = currentTheme.main;
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      for (let i = 0; i < points.length; i++) {
        if (i === 0) ctx.moveTo(points[i].x, points[i].y);
        else {
          const xc = (points[i].x + points[i - 1].x) / 2;
          const yc = (points[i].y + points[i - 1].y) / 2;
          ctx.quadraticCurveTo(points[i - 1].x, points[i - 1].y, xc, yc);
        }
      }
      ctx.lineTo(points[points.length - 1].x, points[points.length - 1].y);
      ctx.stroke();

      // Error marker dots
      chartData.forEach((d, i) => {
        if (d.errors > 0 && i > 0 && d.errors > chartData[i - 1].errors) {
          const pt = points[i];
          ctx.fillStyle = currentTheme.error;
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, 4, 0, Math.PI * 2);
          ctx.fill();
        }
      });

      // Interactive hover listener
      const onChartMouseMove = (e: MouseEvent) => {
        if (!chartTooltip) return;
        const cRect = chartCanvas.getBoundingClientRect();
        const mx = e.clientX - cRect.left;
        
        // Find closest point
        let closest = points[0];
        let minDist = Math.abs(points[0].x - mx);
        for (const pt of points) {
          const dist = Math.abs(pt.x - mx);
          if (dist < minDist) {
            minDist = dist;
            closest = pt;
          }
        }

        if (closest && minDist < 30) {
          chartTooltip.style.left = `${closest.x}px`;
          chartTooltip.style.top = `${closest.y}px`;
          chartTooltip.innerHTML = `
            <div class="font-bold text-[var(--mt-main)]">${closest.data.second}s</div>
            <div>wpm: <span class="font-bold">${closest.data.wpm}</span></div>
            <div>raw: <span class="font-bold">${closest.data.rawWpm}</span></div>
            ${closest.data.errors > 0 ? `<div style="color: var(--mt-error)">err: ${closest.data.errors}</div>` : ''}
          `;
          chartTooltip.classList.remove('hidden');
        } else {
          chartTooltip.classList.add('hidden');
        }
      };

      const onChartMouseLeave = () => {
        chartTooltip?.classList.add('hidden');
      };

      chartCanvas.onmousemove = onChartMouseMove;
      chartCanvas.onmouseleave = onChartMouseLeave;
    }

    // 13. Core Keystroke Handler
    function handleKey(key: string) {
      if (isTestComplete) return;

      // Deduplication guard: ignore duplicate event within 30ms
      const now = performance.now();
      if (now - lastKeyProcessedTime < 30 && key === lastKeyProcessed) {
        return;
      }
      lastKeyProcessedTime = now;
      lastKeyProcessed = key;

      if (!isTestRunning) startTest();

      const currentWord = words[currentWordIndex];
      if (!currentWord) return;

      const activeWordDiv = wordsWrapper?.querySelector(`[data-word-idx="${currentWordIndex}"]`) as HTMLElement | null;
      const letters = activeWordDiv?.querySelectorAll('.mt-letter:not(.extra-char)') as NodeListOf<HTMLElement> | undefined;
      const extraLetters = activeWordDiv?.querySelectorAll('.extra-char') as NodeListOf<HTMLElement> | undefined;

      // Space key -> advance word
      if (key === ' ' || (key === 'Enter' && currentWord === '↵')) {
        soundEngine.playKey(true);
        currentLatinBuffer = '';

        if (currentCharIndex > 0 || currentWord === '↵') {
          // If word incomplete, penalize missing characters
          if (letters && currentCharIndex < letters.length && currentWord !== '↵') {
            missedWordsSet.add(currentWord);
            for (let i = currentCharIndex; i < letters.length; i++) {
              if (!blindMode) {
                letters[i].style.color = 'var(--mt-error)';
                letters[i].style.opacity = '0.5';
              }
              missedCharsCount++;
              errorChars++;
              if (wordCharStates[currentWordIndex]) wordCharStates[currentWordIndex][i] = false;
            }
          }

          if (activeWordDiv) activeWordDiv.classList.remove('active-word');
          currentWordIndex++;
          currentCharIndex = 0;

          // Infinite Zen mode word append
          if (mode === 'zen' && currentWordIndex >= words.length - 10) {
            const moreWords = generateMonkeytypeWordList(50, wordPool, includePunc, includeNum, wordPool, scriptMode);
            words.push(...moreWords);
            moreWords.forEach(w => wordCharStates.push(new Array(w.length).fill(null)));
            moreWords.forEach((w, idx) => {
              const globalIdx = words.length - moreWords.length + idx;
              const wDiv = document.createElement('div');
              wDiv.className = 'mt-word inline-block mr-3 mb-1.5 transition-colors duration-150';
              wDiv.setAttribute('data-word-idx', `${globalIdx}`);
              w.split('').forEach((ch, cIdx) => {
                const lSpan = document.createElement('span');
                lSpan.textContent = ch;
                lSpan.className = 'mt-letter transition-colors';
                lSpan.setAttribute('data-char-idx', `${cIdx}`);
                lSpan.style.color = 'var(--mt-sub)';
                wDiv.appendChild(lSpan);
              });
              wordsWrapper?.appendChild(wDiv);
            });
          }

          if (currentWordIndex >= words.length && mode !== 'zen') {
            finishTest();
            return;
          }

          const nextWordDiv = wordsWrapper?.querySelector(`[data-word-idx="${currentWordIndex}"]`) as HTMLElement | null;
          if (nextWordDiv) nextWordDiv.classList.add('active-word');
          positionCaret();
        }
        return;
      }

      // Backspace Handler
      if (key === 'Backspace') {
        if (confidenceMode) return; // In confidence mode, backspace is disabled
        soundEngine.playKey();
        currentLatinBuffer = currentLatinBuffer.slice(0, -1);

        // 1. Remove extra character if present
        if (extraLetters && extraLetters.length > 0) {
          const lastExtra = extraLetters[extraLetters.length - 1];
          lastExtra.remove();
          currentCharIndex = Math.max(currentWord.length, currentCharIndex - 1);
          extraCharsCount = Math.max(0, extraCharsCount - 1);
          errorChars = Math.max(0, errorChars - 1);
          positionCaret();
          return;
        }

        // 2. Erase inside current word
        if (currentCharIndex > 0) {
          currentCharIndex--;
          const prevStatus = wordCharStates[currentWordIndex]?.[currentCharIndex];
          if (prevStatus === true) correctChars = Math.max(0, correctChars - 1);
          else if (prevStatus === false) errorChars = Math.max(0, errorChars - 1);

          if (wordCharStates[currentWordIndex]) wordCharStates[currentWordIndex][currentCharIndex] = null;
          if (letters && letters[currentCharIndex]) {
            letters[currentCharIndex].style.color = 'var(--mt-sub)';
            letters[currentCharIndex].style.opacity = '1';
          }
          positionCaret();
          return;
        }

        // 3. Jump to previous word if previous word had errors
        if (currentCharIndex === 0 && currentWordIndex > 0) {
          const prevStates = wordCharStates[currentWordIndex - 1];
          const hadErrors = prevStates?.some(s => s === false);
          if (hadErrors) {
            if (activeWordDiv) activeWordDiv.classList.remove('active-word');
            currentWordIndex--;
            const prevWord = words[currentWordIndex];
            const prevWordDiv = wordsWrapper?.querySelector(`[data-word-idx="${currentWordIndex}"]`) as HTMLElement | null;
            if (prevWordDiv) prevWordDiv.classList.add('active-word');
            currentCharIndex = prevWord.length;
            positionCaret();
          }
        }
        return;
      }

      // Printable single character
      if (key.length === 1) {
        totalKeystrokes++;
        currentLatinBuffer += key;
        const expected = currentWord[currentCharIndex];
        let isMatch = key === expected;

        if (!isMatch && scriptMode === 'native' && wordPool !== 'english' && wordPool !== 'english1k' && wordPool !== 'code') {
          // 1. Direct keyboard layout mapping check (e.g. InScript, Cyrillic, Arabic layout)
          const langOverrides = KEY_LABEL_OVERRIDES[wordPool] || KEY_LABEL_OVERRIDES[wordPool.slice(0, 2)];
          if (langOverrides) {
            const mapped = langOverrides[key.toLowerCase()]?.display;
            if (mapped && (mapped === expected || mapped.toLowerCase() === (expected || '').toLowerCase())) {
              isMatch = true;
            }
          }

          // 2. Phonetic transliteration check
          if (!isMatch) {
            const trans = transliterateInput(currentLatinBuffer, wordPool, 'native');
            const partialExpected = currentWord.slice(0, currentCharIndex + 1);
            if (trans === partialExpected || trans.endsWith(expected) || (trans.length > 0 && partialExpected.endsWith(trans[trans.length - 1]))) {
              isMatch = true;
            }
          }

          // 3. Smart Accents check
          if (!isMatch) {
            const smartAcc = applySmartAccents(key, wordPool);
            if (smartAcc === expected || smartAcc.toLowerCase() === (expected || '').toLowerCase()) {
              isMatch = true;
            }
          }
        }

        // Keystroke telemetry log for Replay
        keystrokeLog.push({
          char: key,
          expected: expected || '',
          isCorrect: isMatch,
          timestamp: Date.now() - (startTime || Date.now()),
          wordIdx: currentWordIndex,
          charIdx: currentCharIndex
        });

        // Telemetry for Weak Key Diagnostics
        storage.recordKeystroke(expected || key, !isMatch);

        if (letters && currentCharIndex < letters.length) {
          const letterEl = letters[currentCharIndex];

          if (isMatch) {
            correctChars++;
            if (wordCharStates[currentWordIndex]) wordCharStates[currentWordIndex][currentCharIndex] = true;
            soundEngine.playKey();
            if (!blindMode) {
              letterEl.style.color = 'var(--mt-text)';
              letterEl.style.fontWeight = 'bold';
            }
          } else {
            errorChars++;
            missedWordsSet.add(currentWord);
            if (wordCharStates[currentWordIndex]) wordCharStates[currentWordIndex][currentCharIndex] = false;
            soundEngine.playError();
            if (!blindMode) {
              letterEl.style.color = 'var(--mt-error)';
              letterEl.style.fontWeight = 'bold';
            }

            // Master Mode fail check
            if (masterMode) {
              if (activeSpeedTestTimer) clearInterval(activeSpeedTestTimer);
              isTestRunning = false;
              isTestComplete = true;
              masterFailOverlay?.classList.remove('hidden');
              return;
            }
          }
        } else {
          // Extra characters beyond word bounds (up to 8)
          if ((extraLetters?.length || 0) < 8) {
            extraCharsCount++;
            errorChars++;
            missedWordsSet.add(currentWord);
            soundEngine.playError();

            if (activeWordDiv) {
              const extraSpan = document.createElement('span');
              extraSpan.textContent = key;
              extraSpan.className = 'mt-letter extra-char font-bold';
              extraSpan.style.color = 'var(--mt-error-extra)';
              extraSpan.style.textDecoration = 'underline';
              activeWordDiv.appendChild(extraSpan);
            }

            if (masterMode) {
              if (activeSpeedTestTimer) clearInterval(activeSpeedTestTimer);
              isTestRunning = false;
              isTestComplete = true;
              masterFailOverlay?.classList.remove('hidden');
              return;
            }
          }
        }

        currentCharIndex++;
        positionCaret();

        // Auto-finish on final char if word / quote / code mode
        if (currentWordIndex === words.length - 1 && currentCharIndex >= currentWord.length && mode !== 'time' && mode !== 'zen') {
          finishTest();
        }
      }
    }

    // 14. Focus Management & Single Input Dispatcher
    const onViewportClick = () => {
      soundEngine.initContext();
      focusInputSafely();
      focusOverlay?.classList.add('hidden');
      positionCaret();
    };
    wordsViewport.addEventListener('click', onViewportClick);
    focusOverlay?.addEventListener('click', onViewportClick);
    activeCleanups.push(() => {
      wordsViewport.removeEventListener('click', onViewportClick);
      focusOverlay?.removeEventListener('click', onViewportClick);
    });

    const onInputBlur = () => {
      if (!isTestComplete && isTestRunning) {
        focusOverlay?.classList.remove('hidden');
      }
    };
    inputEl?.addEventListener('blur', onInputBlur);
    activeCleanups.push(() => inputEl?.removeEventListener('blur', onInputBlur));

    const onInputFocus = () => {
      focusOverlay?.classList.add('hidden');
      positionCaret();
    };
    inputEl?.addEventListener('focus', onInputFocus);
    activeCleanups.push(() => inputEl?.removeEventListener('focus', onInputFocus));

    // Input Keydown Handler (strictly on unified input)
    const onInputKeyDown = (e: KeyboardEvent) => {
      soundEngine.initContext();

      if (e.key === ' ' || e.key === 'Backspace' || e.key === 'Enter' || (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey)) {
        e.preventDefault();
        e.stopPropagation();
        handleKey(e.key);
      }
    };
    inputEl?.addEventListener('keydown', onInputKeyDown);
    activeCleanups.push(() => inputEl?.removeEventListener('keydown', onInputKeyDown));

    // Global Key Listener for Quick Focus / Command Palette / Tab Restart
    const onGlobalKeyDown = (e: KeyboardEvent) => {
      const isSpeedTestPage = window.location.pathname.startsWith('/speed-test');

      // Don't intercept if user is typing in a modal textfield or search box
      const target = e.target as HTMLElement | null;
      if (target && target !== inputEl && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA')) {
        return;
      }

      if (
        (cmdPalette && !cmdPalette.classList.contains('hidden')) ||
        (customModal && !customModal.classList.contains('hidden')) ||
        (customTextModal && !customTextModal.classList.contains('hidden')) ||
        (replayModal && !replayModal.classList.contains('hidden'))
      ) {
        return;
      }

      // If on homepage and not focused in speed test, do not hijack global keys
      if (!isSpeedTestPage && document.activeElement !== inputEl && !isTestRunning) {
        return;
      }

      // Caps Lock detection
      const isCaps = e.getModifierState && e.getModifierState('CapsLock');
      if (capsWarning) {
        capsWarning.classList.toggle('hidden', !isCaps);
      }

      // Esc or Ctrl+Shift+P opens Command Palette
      if (e.key === 'Escape' || (e.key === 'P' && e.ctrlKey && e.shiftKey)) {
        e.preventDefault();
        toggleCommandPalette();
        return;
      }

      // Tab + Enter or single Tab restart
      if (e.key === 'Tab') {
        e.preventDefault();
        generateWords();
        focusInputSafely();
        return;
      }

      // Shift + Enter in Zen mode
      if (e.key === 'Enter' && e.shiftKey && mode === 'zen') {
        e.preventDefault();
        finishTest();
        return;
      }

      // Forward any printable keystroke or Space/Backspace directly to handleKey
      if (e.key === ' ' || e.key === 'Backspace' || e.key === 'Enter' || (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey)) {
        e.preventDefault();
        if (document.activeElement !== inputEl) {
          focusInputSafely();
        }
        handleKey(e.key);
      }
    };
    window.addEventListener('keydown', onGlobalKeyDown);
    activeCleanups.push(() => window.removeEventListener('keydown', onGlobalKeyDown));

    // Fallback for virtual keyboards & mobile IME input
    const onInputValue = (e: Event) => {
      soundEngine.initContext();
      const val = (e.target as HTMLInputElement).value;
      if (val.length > 0) {
        for (let i = 0; i < val.length; i++) {
          handleKey(val[i]);
        }
        (e.target as HTMLInputElement).value = '';
      }
    };
    inputEl?.addEventListener('input', onInputValue);
    activeCleanups.push(() => inputEl?.removeEventListener('input', onInputValue));

    // 15. Command Palette System
    function toggleCommandPalette() {
      if (!cmdPalette) return;
      const isHidden = cmdPalette.classList.contains('hidden');
      if (isHidden) {
        cmdPalette.classList.remove('hidden');
        renderCommandList('');
        if (cmdSearch) {
          cmdSearch.value = '';
          try {
            cmdSearch.focus({ preventScroll: true });
          } catch {
            cmdSearch.focus();
          }
        }
      } else {
        cmdPalette.classList.add('hidden');
        focusInputSafely();
      }
    }

    cmdHintBtn?.addEventListener('click', toggleCommandPalette);

    const commands = [
      ...MONKEYTYPE_THEMES.map(t => ({ label: `Theme: ${t.name}`, action: () => applyCurrentTheme(t), icon: '🎨' })),
      { label: 'Time: 15s', action: () => setTimeMode(15), icon: '⏱️' },
      { label: 'Time: 30s', action: () => setTimeMode(30), icon: '⏱️' },
      { label: 'Time: 60s', action: () => setTimeMode(60), icon: '⏱️' },
      { label: 'Time: 120s', action: () => setTimeMode(120), icon: '⏱️' },
      { label: 'Words: 10', action: () => setWordsMode(10), icon: '📝' },
      { label: 'Words: 25', action: () => setWordsMode(25), icon: '📝' },
      { label: 'Words: 50', action: () => setWordsMode(50), icon: '📝' },
      { label: 'Words: 100', action: () => setWordsMode(100), icon: '📝' },
      { label: 'Mode: Time', action: () => switchMode('time'), icon: '⏱️' },
      { label: 'Mode: Words', action: () => switchMode('words'), icon: '📝' },
      { label: 'Mode: Quotes', action: () => switchMode('quote'), icon: '💬' },
      { label: 'Mode: Zen', action: () => switchMode('zen'), icon: '☯' },
      { label: 'Mode: Custom Drill', action: () => openCustomTextModal(), icon: '✏️' },
      { label: 'Language: English 200', action: () => setWordPool('english'), icon: '🌐' },
      { label: 'Language: English 1k', action: () => setWordPool('english1k'), icon: '🌐' },
      { label: 'Language: Code Snippets', action: () => setWordPool('code'), icon: '💻' },
      { label: 'Sound: Clicky Blue', action: () => setSound('clicky'), icon: '🔊' },
      { label: 'Sound: Thock Panda', action: () => setSound('thock'), icon: '🔊' },
      { label: 'Sound: Red Linear', action: () => setSound('linear'), icon: '🔊' },
      { label: 'Sound: Typewriter', action: () => setSound('typewriter'), icon: '🔊' },
      { label: 'Sound: Pop Bubble', action: () => setSound('pop'), icon: '🔊' },
      { label: 'Sound: Digital Beep', action: () => setSound('beep'), icon: '🔊' },
      { label: 'Sound: Mute', action: () => setSound('off'), icon: '🔇' },
      { label: 'Caret: Line (|)', action: () => setCaretStyle('line'), icon: '🥕' },
      { label: 'Caret: Block (█)', action: () => setCaretStyle('block'), icon: '🥕' },
      { label: 'Caret: Underline (_)', action: () => setCaretStyle('underline'), icon: '🥕' },
      { label: 'Caret: Outline (▯)', action: () => setCaretStyle('outline'), icon: '🥕' },
      { label: 'Caret: Carrot (🥕)', action: () => setCaretStyle('carrot'), icon: '🥕' },
      { label: 'Toggle Punctuation', action: () => togglePunctuation(), icon: '@' },
      { label: 'Toggle Numbers', action: () => toggleNumbers(), icon: '#' },
      { label: 'Toggle Confidence Mode (No Backspace)', action: () => toggleConfidenceMode(), icon: '🔒' },
      { label: 'Toggle Master Mode (Fail on 1 Error)', action: () => toggleMasterMode(), icon: '👑' },
      { label: 'Toggle Blind Mode (No Colors Until End)', action: () => toggleBlindMode(), icon: '🙈' },
      { label: 'Restart Test', action: () => generateWords(), icon: '⟲' }
    ];

    let activeCmdIndex = 0;
    let filteredCmds = [...commands];

    function renderCommandList(query: string) {
      if (!cmdList) return;
      const q = query.toLowerCase().trim();
      filteredCmds = q ? commands.filter(c => c.label.toLowerCase().includes(q)) : commands;
      activeCmdIndex = 0;

      cmdList.innerHTML = '';
      if (filteredCmds.length === 0) {
        cmdList.innerHTML = `<div class="p-3 text-center opacity-50">No matching commands</div>`;
        return;
      }

      filteredCmds.forEach((cmd, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `flex items-center justify-between p-2.5 rounded-xl text-left transition cursor-pointer ${idx === activeCmdIndex ? 'font-bold' : ''}`;
        btn.style.backgroundColor = idx === activeCmdIndex ? 'var(--mt-main)' : 'var(--mt-sub-alt)';
        btn.style.color = idx === activeCmdIndex ? 'var(--mt-bg)' : 'var(--mt-text)';
        btn.innerHTML = `
          <span class="flex items-center gap-2"><span>${cmd.icon}</span> <span>${cmd.label}</span></span>
          <span class="text-[10px] opacity-60">enter ↵</span>
        `;
        btn.addEventListener('click', () => {
          cmd.action();
          toggleCommandPalette();
        });
        cmdList.appendChild(btn);
      });
    }

    cmdSearch?.addEventListener('input', (e) => {
      renderCommandList((e.target as HTMLInputElement).value);
    });

    cmdSearch?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeCmdIndex = (activeCmdIndex + 1) % filteredCmds.length;
        updateCmdSelection();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeCmdIndex = (activeCmdIndex - 1 + filteredCmds.length) % filteredCmds.length;
        updateCmdSelection();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (filteredCmds[activeCmdIndex]) {
          filteredCmds[activeCmdIndex].action();
          toggleCommandPalette();
        }
      } else if (e.key === 'Escape') {
        e.preventDefault();
        toggleCommandPalette();
      }
    });

    function updateCmdSelection() {
      if (!cmdList) return;
      const items = cmdList.querySelectorAll('button');
      items.forEach((btn, idx) => {
        if (idx === activeCmdIndex) {
          btn.style.backgroundColor = 'var(--mt-main)';
          btn.style.color = 'var(--mt-bg)';
          btn.classList.add('font-bold');
          btn.scrollIntoView({ block: 'nearest' });
        } else {
          btn.style.backgroundColor = 'var(--mt-sub-alt)';
          btn.style.color = 'var(--mt-text)';
          btn.classList.remove('font-bold');
        }
      });
    }

    cmdPalette?.addEventListener('click', (e) => {
      if (e.target === cmdPalette) toggleCommandPalette();
    });

    // 16. Mode Switching Functions
    function switchMode(newMode: 'time' | 'words' | 'quote' | 'zen' | 'custom') {
      mode = newMode;
      const modeBtns = rootEl?.querySelectorAll('.mt-mode-btn');
      modeBtns?.forEach(btn => {
        const bMode = btn.getAttribute('data-mode');
        if (bMode === mode) {
          btn.classList.add('active');
          (btn as HTMLElement).style.color = 'var(--mt-main)';
        } else {
          btn.classList.remove('active');
          (btn as HTMLElement).style.color = 'var(--mt-sub)';
        }
      });

      if (subContainer) {
        if (mode === 'time') {
          subContainer.innerHTML = `
            <button type="button" data-sub="15" class="mt-sub-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]">15</button>
            <button type="button" data-sub="30" class="mt-sub-btn active rounded-lg px-2 py-1 font-bold transition cursor-pointer" style="color: var(--mt-main);">30</button>
            <button type="button" data-sub="60" class="mt-sub-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]">60</button>
            <button type="button" data-sub="120" class="mt-sub-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]">120</button>
            <button type="button" id="mt-custom-sub-btn" class="mt-sub-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]">⚙</button>
          `;
          subOption = 30;
        } else if (mode === 'words') {
          subContainer.innerHTML = `
            <button type="button" data-sub="10" class="mt-sub-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]">10</button>
            <button type="button" data-sub="25" class="mt-sub-btn active rounded-lg px-2 py-1 font-bold transition cursor-pointer" style="color: var(--mt-main);">25</button>
            <button type="button" data-sub="50" class="mt-sub-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]">50</button>
            <button type="button" data-sub="100" class="mt-sub-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]">100</button>
            <button type="button" id="mt-custom-sub-btn" class="mt-sub-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]">⚙</button>
          `;
          subOption = 25;
        } else if (mode === 'quote') {
          subContainer.innerHTML = `
            <button type="button" data-qlen="all" class="mt-qlen-btn active rounded-lg px-2 py-1 font-bold transition cursor-pointer" style="color: var(--mt-main);">all</button>
            <button type="button" data-qlen="short" class="mt-qlen-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]">short</button>
            <button type="button" data-qlen="medium" class="mt-qlen-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]">medium</button>
            <button type="button" data-qlen="long" class="mt-qlen-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]">long</button>
            <button type="button" data-qlen="thicc" class="mt-qlen-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]">thicc</button>
          `;
        } else if (mode === 'custom') {
          subContainer.innerHTML = `
            <button type="button" id="mt-edit-custom-text-btn" class="rounded-lg px-2.5 py-1 text-xs font-bold transition cursor-pointer" style="background-color: var(--mt-bg); color: var(--mt-main);">change text ✏️</button>
          `;
        } else {
          subContainer.innerHTML = '';
        }
        bindSubOptionButtons();
      }

      generateWords();
      focusInputSafely();
    }

    function setTimeMode(seconds: number) {
      mode = 'time';
      subOption = seconds;
      switchMode('time');
    }

    function setWordsMode(count: number) {
      mode = 'words';
      subOption = count;
      switchMode('words');
    }

    function setWordPool(pool: string) {
      wordPool = pool;
      if (poolLabel) {
        const poolLabels: Record<string, string> = {
          english: 'english 200',
          english1k: 'english 1k',
          hindi: 'हिन्दी (hindi)',
          spanish: 'español',
          french: 'français',
          german: 'deutsch',
          japanese: '日本語 (romaji)',
          portuguese: 'português',
          russian: 'русский',
          arabic: 'العربية (arabic)',
          chinese: '中文 (pinyin)',
          italian: 'italiano',
          korean: '한국어 (romaja)',
          indonesian: 'indonesia',
          turkish: 'türkçe',
          vietnamese: 'tiếng việt',
          bengali: 'বাংলা (bengali)',
          code: 'code'
        };
        poolLabel.textContent = poolLabels[pool] || pool;
      }

      // Update script toggle visibility
      const isSupported = isNativeScriptSupported(pool);
      if (scriptToggleWrapper) {
        if (isSupported && pool !== 'english' && pool !== 'english1k' && pool !== 'code') {
          scriptToggleWrapper.classList.remove('hidden');
          if (phoneticBadge) phoneticBadge.classList.toggle('hidden', scriptMode !== 'native');
        } else {
          scriptToggleWrapper.classList.add('hidden');
          if (phoneticBadge) phoneticBadge.classList.add('hidden');
        }
      }

      // Update checkmark in dropdown
      document.querySelectorAll('.mt-pool-opt').forEach(opt => {
        const p = opt.getAttribute('data-pool');
        const check = opt.querySelector('.check');
        if (check) {
          if (p === pool) {
            check.classList.remove('hidden');
            opt.classList.add('active-pool', 'font-bold');
          } else {
            check.classList.add('hidden');
            opt.classList.remove('active-pool', 'font-bold');
          }
        }
      });

      generateWords();
      focusInputSafely();
    }

    const updateScriptUI = () => {
      if (scriptNativeBtn && scriptLatinBtn) {
        if (scriptMode === 'native') {
          scriptNativeBtn.style.backgroundColor = 'var(--mt-main)';
          scriptNativeBtn.style.color = 'var(--mt-bg)';
          scriptNativeBtn.classList.remove('opacity-70');
          scriptLatinBtn.style.backgroundColor = 'transparent';
          scriptLatinBtn.style.color = 'var(--mt-text)';
          scriptLatinBtn.classList.add('opacity-70');
          if (phoneticBadge) phoneticBadge.classList.remove('hidden');
        } else {
          scriptLatinBtn.style.backgroundColor = 'var(--mt-main)';
          scriptLatinBtn.style.color = 'var(--mt-bg)';
          scriptLatinBtn.classList.remove('opacity-70');
          scriptNativeBtn.style.backgroundColor = 'transparent';
          scriptNativeBtn.style.color = 'var(--mt-text)';
          scriptNativeBtn.classList.add('opacity-70');
          if (phoneticBadge) phoneticBadge.classList.add('hidden');
        }
      }
    };

    scriptNativeBtn?.addEventListener('click', () => {
      scriptMode = 'native';
      updateScriptUI();
      generateWords();
      focusInputSafely();
    });

    scriptLatinBtn?.addEventListener('click', () => {
      scriptMode = 'latin';
      updateScriptUI();
      generateWords();
      focusInputSafely();
    });

    function setSound(sw: SwitchSoundType) {
      soundEngine.setSwitch(sw);
      soundEngine.initContext();
      soundEngine.playKey(false, sw === 'typewriter');
      updateSoundUI();
    }

    function setCaretStyle(style: 'line' | 'block' | 'underline' | 'outline' | 'carrot') {
      caretStyle = style;
      updateCaretAppearance();
      positionCaret();
    }

    function togglePunctuation() {
      includePunc = !includePunc;
      if (togglePuncBtn) {
        if (includePunc) {
          togglePuncBtn.style.color = 'var(--mt-main)';
          togglePuncBtn.classList.add('font-bold');
        } else {
          togglePuncBtn.style.color = 'var(--mt-sub)';
          togglePuncBtn.classList.remove('font-bold');
        }
      }
      generateWords();
    }

    function toggleNumbers() {
      includeNum = !includeNum;
      if (toggleNumBtn) {
        if (includeNum) {
          toggleNumBtn.style.color = 'var(--mt-main)';
          toggleNumBtn.classList.add('font-bold');
        } else {
          toggleNumBtn.style.color = 'var(--mt-sub)';
          toggleNumBtn.classList.remove('font-bold');
        }
      }
      generateWords();
    }

    function toggleConfidenceMode() {
      confidenceMode = !confidenceMode;
    }

    function toggleMasterMode() {
      masterMode = !masterMode;
    }

    function toggleBlindMode() {
      blindMode = !blindMode;
    }

    // 17. Bind Sub-Option Buttons
    function bindSubOptionButtons() {
      const subBtns = subContainer?.querySelectorAll('.mt-sub-btn:not(#mt-custom-sub-btn)');
      subBtns?.forEach(btn => {
        btn.addEventListener('click', () => {
          subBtns.forEach(b => {
            b.classList.remove('active', 'font-bold');
            (b as HTMLElement).style.color = 'var(--mt-sub)';
          });
          btn.classList.add('active', 'font-bold');
          (btn as HTMLElement).style.color = 'var(--mt-main)';
          subOption = parseInt(btn.getAttribute('data-sub') || '30', 10);
          generateWords();
          focusInputSafely();
        });
      });

      const qlenBtns = subContainer?.querySelectorAll('.mt-qlen-btn');
      qlenBtns?.forEach(btn => {
        btn.addEventListener('click', () => {
          qlenBtns.forEach(b => {
            b.classList.remove('active', 'font-bold');
            (b as HTMLElement).style.color = 'var(--mt-sub)';
          });
          btn.classList.add('active', 'font-bold');
          (btn as HTMLElement).style.color = 'var(--mt-main)';
          quoteLength = (btn.getAttribute('data-qlen') || 'all') as any;
          generateWords();
          focusInputSafely();
        });
      });

      const editCustomBtn = document.getElementById('mt-edit-custom-text-btn');
      editCustomBtn?.addEventListener('click', openCustomTextModal);

      const customBtn = document.getElementById('mt-custom-sub-btn');
      customBtn?.addEventListener('click', openCustomModal);
    }

    // 18. Custom Modal Handlers
    function openCustomModal() {
      if (!customModal) return;
      const title = document.getElementById('mt-custom-modal-title');
      const label = document.getElementById('mt-custom-input-label');
      if (title && label) {
        if (mode === 'time') {
          title.textContent = 'Custom Test Time';
          label.textContent = 'Enter custom time (seconds):';
          if (customValInput) customValInput.value = `${subOption}`;
        } else {
          title.textContent = 'Custom Word Count';
          label.textContent = 'Enter custom word count:';
          if (customValInput) customValInput.value = `${subOption}`;
        }
      }
      customModal.classList.remove('hidden');
      try {
        customValInput?.focus({ preventScroll: true });
      } catch {
        customValInput?.focus();
      }
    }

    customCloseBtn?.addEventListener('click', () => customModal?.classList.add('hidden'));
    customCancelBtn?.addEventListener('click', () => customModal?.classList.add('hidden'));
    customSaveBtn?.addEventListener('click', () => {
      const val = parseInt(customValInput?.value || '30', 10);
      if (val > 0) {
        subOption = val;
        customModal?.classList.add('hidden');
        generateWords();
        focusInputSafely();
      }
    });

    // Custom Text Modal
    function openCustomTextModal() {
      if (!customTextModal) return;
      if (customTextarea) customTextarea.value = customTextBuffer;
      customTextModal.classList.remove('hidden');
      try {
        customTextarea?.focus({ preventScroll: true });
      } catch {
        customTextarea?.focus();
      }
    }

    customTextCloseBtn?.addEventListener('click', () => customTextModal?.classList.add('hidden'));
    customTextCancelBtn?.addEventListener('click', () => customTextModal?.classList.add('hidden'));
    customTextSaveBtn?.addEventListener('click', () => {
      const text = customTextarea?.value.trim() || '';
      if (text) {
        customTextBuffer = text;
        mode = 'custom';
        customTextModal?.classList.add('hidden');
        switchMode('custom');
      }
    });

    // Sound Cycle Button
    soundCycleBtn?.addEventListener('click', () => {
      const cycle: SwitchSoundType[] = ['clicky', 'thock', 'linear', 'typewriter', 'pop', 'beep', 'off'];
      const cur = soundEngine.getSwitch();
      const nextIdx = (cycle.indexOf(cur) + 1) % cycle.length;
      setSound(cycle[nextIdx]);
    });

    // Caret Cycle Button
    caretCycleBtn?.addEventListener('click', () => {
      const cycle: ('line' | 'block' | 'underline' | 'outline' | 'carrot')[] = ['line', 'block', 'underline', 'outline', 'carrot'];
      const nextIdx = (cycle.indexOf(caretStyle) + 1) % cycle.length;
      setCaretStyle(cycle[nextIdx]);
    });

    // Word Pool Dropdown
    const onPoolBtnClick = (e: MouseEvent) => {
      e.stopPropagation();
      poolMenu?.classList.toggle('hidden');
    };
    poolBtn?.addEventListener('click', onPoolBtnClick);
    activeCleanups.push(() => poolBtn?.removeEventListener('click', onPoolBtnClick));

    const onDocumentPoolClick = (e: MouseEvent) => {
      if (!poolMenu?.contains(e.target as Node) && !poolBtn?.contains(e.target as Node)) {
        poolMenu?.classList.add('hidden');
      }
    };
    document.addEventListener('click', onDocumentPoolClick);
    activeCleanups.push(() => document.removeEventListener('click', onDocumentPoolClick));

    const poolOptions = document.querySelectorAll('.mt-pool-opt');
    poolOptions.forEach(opt => {
      opt.addEventListener('click', (e) => {
        e.stopPropagation();
        const pool = (opt.getAttribute('data-pool') || 'english') as any;
        setWordPool(pool);
        poolMenu?.classList.add('hidden');
      });
    });

    // Modifiers Buttons
    togglePuncBtn?.addEventListener('click', togglePunctuation);
    toggleNumBtn?.addEventListener('click', toggleNumbers);

    // Mode Buttons Top
    const modeBtns = rootEl.querySelectorAll('.mt-mode-btn');
    modeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const m = (btn.getAttribute('data-mode') || 'time') as any;
        switchMode(m);
      });
    });

    // Zen Finish Button
    zenFinishBtn?.addEventListener('click', finishTest);

    // Master Restart Button
    masterRestartBtn?.addEventListener('click', () => {
      generateWords();
      focusInputSafely();
    });

    // Restart Button
    restartBtn?.addEventListener('click', () => {
      generateWords();
      focusInputSafely();
    });

    // Result Screen Buttons
    resNextBtn?.addEventListener('click', () => {
      generateWords();
      focusInputSafely();
    });
    resRepeatBtn?.addEventListener('click', () => {
      generateWords();
      focusInputSafely();
    });

    // Practice Missed Words
    resPracticeMissedBtn?.addEventListener('click', () => {
      if (missedWordsSet.size === 0) return;
      isReplayingMissed = true;
      words = Array.from(missedWordsSet);
      wordCharStates = words.map(w => new Array(w.length).fill(null));
      currentWordIndex = 0;
      currentCharIndex = 0;
      correctChars = 0;
      errorChars = 0;
      extraCharsCount = 0;
      totalKeystrokes = 0;
      trajectory = [];
      keystrokeLog = [];

      resultView?.classList.add('hidden');
      typingView?.classList.remove('hidden');
      if (liveCounter) liveCounter.textContent = `${words.length}w missed`;

      renderWordsDOM();
      requestAnimationFrame(() => positionCaret());
      focusInputSafely();
    });

    // Replay Modal Playback
    resReplayBtn?.addEventListener('click', () => {
      if (!replayModal || !replayWordsWrapper) return;
      replayModal.classList.remove('hidden');
      let replaySpeed = 1;
      let replayTimer: number | null = null;

      // Render replay words
      replayWordsWrapper.innerHTML = '';
      words.forEach((w, wIdx) => {
        const wDiv = document.createElement('div');
        wDiv.className = 'inline-block mr-3 mb-1.5';
        wDiv.setAttribute('data-rep-word', `${wIdx}`);
        w.split('').forEach((ch, cIdx) => {
          const lSpan = document.createElement('span');
          lSpan.textContent = ch;
          lSpan.setAttribute('data-rep-char', `${cIdx}`);
          lSpan.style.color = 'var(--mt-sub)';
          wDiv.appendChild(lSpan);
        });
        replayWordsWrapper.appendChild(wDiv);
      });

      const playReplay = () => {
        if (replayTimer) clearInterval(replayTimer);
        let logIdx = 0;
        const totalEvents = keystrokeLog.length;
        if (totalEvents === 0) return;

        const replayStart = Date.now();
        const firstTime = keystrokeLog[0].timestamp;

        replayTimer = window.setInterval(() => {
          const currentElapsed = (Date.now() - replayStart) * replaySpeed;
          if (replayTime) replayTime.textContent = `${(currentElapsed / 1000).toFixed(1)}s`;

          while (logIdx < totalEvents && keystrokeLog[logIdx].timestamp - firstTime <= currentElapsed) {
            const ev = keystrokeLog[logIdx];
            const wEl = replayWordsWrapper.querySelector(`[data-rep-word="${ev.wordIdx}"]`);
            const cEl = wEl?.querySelector(`[data-rep-char="${ev.charIdx}"]`) as HTMLElement | null;
            if (cEl) {
              cEl.style.color = ev.isCorrect ? 'var(--mt-text)' : 'var(--mt-error)';
              cEl.style.fontWeight = 'bold';
            }
            logIdx++;
          }

          if (logIdx >= totalEvents) {
            if (replayTimer) clearInterval(replayTimer);
            if (replayPlayBtn) replayPlayBtn.textContent = 'Replay Again';
          }
        }, 16);
      };

      replayPlayBtn?.addEventListener('click', playReplay);

      const speedBtns = replayModal.querySelectorAll('.mt-replay-speed');
      speedBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          speedBtns.forEach(b => {
            b.classList.remove('active');
            (b as HTMLElement).style.color = 'var(--mt-sub)';
          });
          btn.classList.add('active');
          (btn as HTMLElement).style.color = 'var(--mt-main)';
          replaySpeed = parseInt(btn.getAttribute('data-speed') || '1', 10);
        });
      });

      playReplay();
    });

    replayCloseBtn?.addEventListener('click', () => {
      replayModal?.classList.add('hidden');
    });

    // Share / Copy Results
    resShareBtn?.addEventListener('click', () => {
      const net = resWpm?.textContent || '0';
      const raw = resRaw?.textContent || '0';
      const acc = resAcc?.textContent || '100%';
      const cons = resConsistency?.textContent || '90%';
      const ttype = resTestType?.textContent || 'time 30';
      const text = `⚡ Monkeytype Result\n🏆 WPM: ${net} (raw ${raw}) | ACC: ${acc}\n🎯 Mode: ${ttype} | Consistency: ${cons}\n🎨 Theme: ${currentTheme.name}\n🎮 Test your speed: https://typinggamezone.com/speed-test`;

      navigator.clipboard.writeText(text).then(() => {
        if (shareLabel) shareLabel.textContent = 'Copied to Clipboard! ✓';
        setTimeout(() => {
          if (shareLabel) shareLabel.textContent = 'Copy Result';
        }, 2000);
      });
    });

    // Window Resize -> Re-position caret
    const onResize = () => positionCaret();
    window.addEventListener('resize', onResize);
    activeCleanups.push(() => window.removeEventListener('resize', onResize));

    // Global Language Change Sync
    const onLangChange = (e: any) => {
      const lang = e.detail?.lang;
      if (lang && wordPool !== 'code') {
        const langMap: Record<string, string> = {
          en: 'english',
          hi: 'hindi',
          es: 'spanish',
          fr: 'french',
          de: 'german',
          ja: 'japanese',
          pt: 'portuguese',
          ru: 'russian',
          ar: 'arabic',
          zh: 'chinese',
          it: 'italian',
          ko: 'korean',
          id: 'indonesian',
          tr: 'turkish',
          vi: 'vietnamese',
          bn: 'bengali'
        };
        const targetPool = langMap[lang] || 'english';
        setWordPool(targetPool);
      }
    };
    window.addEventListener('typing:language-change', onLangChange);
    activeCleanups.push(() => window.removeEventListener('typing:language-change', onLangChange));

    // Initial setup
    bindSubOptionButtons();
    generateWords();
    if (window.location.pathname.startsWith('/speed-test')) {
      focusInputSafely();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMonkeytypeEngine);
  } else {
    initMonkeytypeEngine();
  }
  document.addEventListener('astro:page-load', initMonkeytypeEngine);
  document.addEventListener('astro:before-swap', () => {
    if (activeSpeedTestTimer) {
      clearInterval(activeSpeedTestTimer);
      activeSpeedTestTimer = null;
    }
    activeCleanups.forEach(c => c());
    activeCleanups = [];
  });
</script>
