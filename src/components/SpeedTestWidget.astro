---
// Authentic Monkeytype Speed Test Widget — 1:1 Monkeytype Engine
// Complete with Themes, Command Palette, Smooth Caret, Live Telemetry, Spline Graphs, Replays & Custom Modes
---

<div
  id="monkeytype-root"
  class="monkeytype-widget-root w-full max-w-5xl mx-auto rounded-3xl p-4 sm:p-8 font-mono transition-colors duration-300 relative select-none"
  style="--mt-bg: #323437; --mt-main: #e2b714; --mt-caret: #e2b714; --mt-sub: #646669; --mt-sub-alt: #2c2e31; --mt-text: #d1d0c5; --mt-error: #ca4754; --mt-error-extra: #7e2a33; background-color: var(--mt-bg); color: var(--mt-text);"
>
  <!-- Ambient backdrop soft glow based on main theme color -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-96 h-96 rounded-full opacity-10 blur-3xl pointer-events-none transition-all duration-500" style="background-color: var(--mt-main);"></div>

  <!-- Top Floating Monkeytype Config Bar -->
  <div
    id="mt-config-bar"
    class="relative z-40 flex flex-wrap items-center justify-between gap-2 sm:gap-3 rounded-2xl p-2 sm:p-2.5 transition-opacity duration-300 text-xs font-semibold select-none shadow-sm"
    style="background-color: var(--mt-sub-alt); color: var(--mt-sub);"
  >
    <!-- Left: Modifiers & Word Pool -->
    <div class="flex flex-wrap items-center gap-1 sm:gap-1.5">
      <!-- Punctuation Toggle -->
      <button
        type="button"
        id="mt-toggle-punc"
        class="mt-config-pill flex items-center gap-1.5 rounded-xl px-2 sm:px-2.5 py-1.5 transition-all cursor-pointer hover:text-[var(--mt-text)]"
        title="Toggle Punctuation (@)"
      >
        <span class="font-bold">@</span>
        <span class="hidden xs:inline sm:inline">punctuation</span>
      </button>

      <!-- Numbers Toggle -->
      <button
        type="button"
        id="mt-toggle-num"
        class="mt-config-pill flex items-center gap-1.5 rounded-xl px-2 sm:px-2.5 py-1.5 transition-all cursor-pointer hover:text-[var(--mt-text)]"
        title="Toggle Numbers (#)"
      >
        <span class="font-bold">#</span>
        <span class="hidden xs:inline sm:inline">numbers</span>
      </button>

      <span class="h-4 w-px mx-0.5 sm:mx-1" style="background-color: var(--mt-sub); opacity: 0.3;"></span>

      <!-- Word Pool Language Selector -->
      <div class="relative z-50" id="mt-pool-dropdown-wrapper">
        <button
          type="button"
          id="mt-pool-btn"
          class="flex items-center gap-1 rounded-xl px-2 sm:px-2.5 py-1.5 transition-all cursor-pointer hover:text-[var(--mt-text)]"
          title="Change Word List / Language"
        >
          <span>🌐</span>
          <span id="mt-pool-label" class="truncate max-w-[90px] xs:max-w-none">english 200</span>
          <svg class="h-3 w-3 opacity-60 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="mt-pool-menu"
          class="absolute left-0 top-full mt-1 hidden w-[min(18rem,calc(100vw-2rem))] rounded-2xl p-2 shadow-2xl z-50 border text-xs max-h-72 overflow-y-auto smooth-scroll-x"
          style="background-color: var(--mt-bg); border-color: var(--mt-sub-alt);"
        >
          <button type="button" data-pool="english" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)] active-pool">
            <span>🇺🇸 English 200</span>
            <span class="check text-[var(--mt-main)]">✓</span>
          </button>
          <button type="button" data-pool="english1k" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇺🇸 English 1k</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="hindi" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇮🇳 हिन्दी (Hindi)</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="spanish" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇪🇸 Español (Spanish)</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="french" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇫🇷 Français (French)</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="german" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇩🇪 Deutsch (German)</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="japanese" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇯🇵 日本語 (Romaji)</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="portuguese" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇧🇷 Português</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="russian" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇷🇺 Русский (Russian)</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="arabic" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇸🇦 العربية (Arabic)</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="chinese" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇨🇳 简体中文 (Pinyin)</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="italian" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇮🇹 Italiano (Italian)</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="korean" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇰🇷 한국어 (Romaja)</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="indonesian" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇮🇩 Bahasa Indonesia</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="turkish" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇹🇷 Türkçe (Turkish)</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="vietnamese" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇻🇳 Tiếng Việt</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="bengali" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)]">
            <span>🇧🇩 বাংলা (Bengali)</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
          <button type="button" data-pool="code" class="mt-pool-opt flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-left transition hover:text-[var(--mt-main)] border-t border-hairline mt-1">
            <span>💻 Code Snippets</span>
            <span class="check text-[var(--mt-main)] hidden">✓</span>
          </button>
        </div>
      </div>

      <!-- Script Mode Toggle (Native Script vs Latin / Romaji) -->
      <div id="mt-script-toggle-wrapper" class="flex items-center gap-1 rounded-xl p-0.5 ml-1 hidden" style="background-color: var(--mt-sub-alt);">
        <button
          type="button"
          id="mt-script-native-btn"
          class="px-2 py-0.5 rounded-lg text-[11px] font-bold transition-all cursor-pointer"
          style="background-color: var(--mt-main); color: var(--mt-bg);"
          title="Type in Native Script with Phonetic Engine"
        >
          <span>🔤 Native</span>
        </button>
        <button
          type="button"
          id="mt-script-latin-btn"
          class="px-2 py-0.5 rounded-lg text-[11px] font-medium transition-all cursor-pointer opacity-70 hover:opacity-100"
          title="Type in Latin / English alphabet"
        >
          <span>🔡 Latin</span>
        </button>
      </div>
    </div>

    <!-- Center: Modes Switcher -->
    <div class="flex items-center gap-1 rounded-xl p-0.5" style="background-color: var(--mt-bg);">
      <button
        type="button"
        data-mode="time"
        class="mt-mode-btn active flex items-center gap-1.5 rounded-lg px-3 py-1.5 font-bold transition cursor-pointer"
        style="color: var(--mt-main);"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>time</span>
      </button>

      <button
        type="button"
        data-mode="words"
        class="mt-mode-btn flex items-center gap-1.5 rounded-lg px-3 py-1.5 font-bold transition cursor-pointer hover:text-[var(--mt-text)]"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>words</span>
      </button>

      <button
        type="button"
        data-mode="quote"
        class="mt-mode-btn flex items-center gap-1.5 rounded-lg px-3 py-1.5 font-bold transition cursor-pointer hover:text-[var(--mt-text)]"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
        </svg>
        <span>quote</span>
      </button>

      <button
        type="button"
        data-mode="zen"
        class="mt-mode-btn flex items-center gap-1.5 rounded-lg px-3 py-1.5 font-bold transition cursor-pointer hover:text-[var(--mt-text)]"
      >
        <span class="text-sm leading-none">☯</span>
        <span>zen</span>
      </button>

      <button
        type="button"
        data-mode="custom"
        class="mt-mode-btn flex items-center gap-1.5 rounded-lg px-3 py-1.5 font-bold transition cursor-pointer hover:text-[var(--mt-text)]"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        <span>custom</span>
      </button>
    </div>

    <!-- Right: Sub-options (15, 30, 60, 120 / 10, 25, 50, 100 / short, medium, long, thicc) -->
    <div id="mt-sub-container" class="flex items-center gap-1">
      <button type="button" data-sub="15" class="mt-sub-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]">15</button>
      <button type="button" data-sub="30" class="mt-sub-btn active rounded-lg px-2 py-1 font-bold transition cursor-pointer" style="color: var(--mt-main);">30</button>
      <button type="button" data-sub="60" class="mt-sub-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]">60</button>
      <button type="button" data-sub="120" class="mt-sub-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]">120</button>
      <button type="button" id="mt-custom-sub-btn" class="mt-sub-btn rounded-lg px-2 py-1 transition cursor-pointer hover:text-[var(--mt-text)]" title="Custom Duration">⚙</button>
    </div>
  </div>

  <!-- Main Speed Test Live Arena -->
  <div id="mt-typing-view" class="relative my-8 transition-opacity duration-300">
    
    <!-- Big Floating Counter / Mini Telemetry Row -->
    <div class="flex items-end justify-between mb-4 px-2 select-none">
      <!-- Live Counter (e.g. 30s countdown or 12/50 words) -->
      <div class="flex items-baseline gap-3">
        <div id="mt-live-counter" class="text-3xl sm:text-4xl font-bold tracking-tight transition-all" style="color: var(--mt-main);">
          30
        </div>
        <div id="mt-live-wpm-pill" class="hidden sm:flex items-center gap-2 text-xs font-semibold opacity-0 transition-opacity" style="color: var(--mt-sub);">
          <span>live wpm: <span id="mt-live-wpm" style="color: var(--mt-main);">0</span></span>
          <span>•</span>
          <span>acc: <span id="mt-live-acc" style="color: var(--mt-text);">100%</span></span>
        </div>
      </div>

      <!-- Quick Action Indicators (Zen finish button / Quote author citation / Phonetic badge) -->
      <div class="flex items-center gap-3">
        <div id="mt-phonetic-badge" class="hidden items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono border" style="background-color: var(--mt-sub-alt); border-color: var(--mt-sub); color: var(--mt-main);">
          <span>✨ Phonetic Typing: Active</span>
        </div>
        <div id="mt-quote-author" class="hidden text-xs italic" style="color: var(--mt-sub);"></div>
        <button
          type="button"
          id="mt-zen-finish-btn"
          class="hidden items-center gap-1 rounded-full px-3 py-1 text-xs font-semibold border transition cursor-pointer hover:brightness-125"
          style="background-color: var(--mt-sub-alt); border-color: var(--mt-sub); color: var(--mt-main);"
        >
          <span>Shift+Enter to finish</span>
          <span>✓</span>
        </button>
      </div>
    </div>

    <!-- Word Arena Viewport -->
    <div
      id="mt-words-viewport"
      class="relative h-36 sm:h-44 overflow-hidden rounded-2xl p-4 sm:p-6 text-xl sm:text-2xl lg:text-3xl leading-[1.8] tracking-wide cursor-text select-none border transition-all"
      style="background-color: var(--mt-bg); border-color: var(--mt-sub-alt);"
      aria-label="Speed Typing Arena"
    >
      <!-- Flowing Words Wrapper (Smooth line jumps with translateY) -->
      <div
        id="mt-words-wrapper"
        class="relative transition-transform duration-100 ease-out select-none flex flex-wrap"
      >
        <!-- Gliding Smooth Caret -->
        <div
          id="mt-caret"
          class="absolute top-0 left-0 transition-all duration-75 ease-out pointer-events-none z-20 opacity-0 caret-idle"
          style="background-color: var(--mt-caret);"
        ></div>

        <!-- Real-Time Ghost Racer Caret -->
        <div
          id="mt-ghost-caret"
          class="absolute top-0 left-0 transition-all duration-100 ease-linear pointer-events-none z-10 hidden flex-col items-center"
        >
          <div class="h-7 w-0.5 rounded-full" style="background-color: var(--site-primary, #e2b714); box-shadow: 0 0 10px var(--site-primary, #e2b714);"></div>
          <span id="mt-ghost-tag" class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded-full absolute -top-4 whitespace-nowrap shadow-md" style="background-color: var(--mt-sub-alt); color: var(--mt-main);">👻 60</span>
        </div>
        <!-- Words injected dynamically via JavaScript -->
      </div>

      <!-- Single Unified Invisible Input (Full area coverage for instant focus & zero latency) -->
      <input
        id="mt-unified-input"
        type="text"
        class="absolute inset-0 w-full h-full opacity-0 cursor-text z-10"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        tabindex="0"
        aria-label="Type here"
      />

      <!-- Blur / Out-of-Focus Overlay (Signature focus prompt) -->
      <div
        id="mt-focus-overlay"
        class="absolute inset-0 flex items-center justify-center backdrop-blur-xs transition-opacity duration-200 cursor-pointer z-30 hidden"
        style="background-color: rgba(0, 0, 0, 0.4);"
      >
        <div class="flex items-center gap-2.5 rounded-full px-5 py-2.5 shadow-2xl border text-sm font-semibold animate-pulse" style="background-color: var(--mt-sub-alt); border-color: var(--mt-sub); color: var(--mt-text);">
          <svg class="h-4 w-4" style="color: var(--mt-main);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
          </svg>
          <span>Click or press any key to focus</span>
        </div>
      </div>

      <!-- Master Mode Failed Banner -->
      <div
        id="mt-master-fail-overlay"
        class="absolute inset-0 flex flex-col items-center justify-center backdrop-blur-sm z-40 hidden animate-in fade-in zoom-in-95 duration-200"
        style="background-color: rgba(202, 71, 84, 0.25);"
      >
        <div class="rounded-2xl p-6 text-center border shadow-2xl max-w-sm" style="background-color: var(--mt-bg); border-color: var(--mt-error);">
          <div class="text-3xl mb-2">❌</div>
          <h4 class="text-lg font-bold" style="color: var(--mt-error);">Master Mode Failed!</h4>
          <p class="text-xs mt-1 mb-4" style="color: var(--mt-sub);">A typo was made. Master mode demands 100% perfection.</p>
          <button type="button" id="mt-master-restart-btn" class="rounded-full px-5 py-2 text-xs font-bold transition hover:scale-105 active:scale-95 cursor-pointer" style="background-color: var(--mt-main); color: var(--mt-bg);">
            Restart Test (Tab + Enter)
          </button>
        </div>
      </div>
    </div>

    <!-- Live Helper Footer Bar (Keybind Hints & Caps Lock Warning) -->
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-xs select-none" style="color: var(--mt-sub);">
      <div class="flex items-center gap-4">
        <!-- Restart Button & Keybind hint -->
        <button
          type="button"
          id="mt-restart-btn"
          class="flex items-center gap-2 rounded-xl px-3 py-1.5 transition cursor-pointer hover:text-[var(--mt-text)]"
          style="background-color: var(--mt-sub-alt);"
          title="Restart Test (Tab + Enter)"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span class="hidden sm:inline"><kbd class="font-bold">tab</kbd> + <kbd class="font-bold">enter</kbd> - restart</span>
          <span class="sm:hidden">Restart</span>
        </button>

        <!-- Command Line shortcut hint -->
        <button
          type="button"
          id="mt-cmd-hint-btn"
          class="hidden sm:flex items-center gap-1.5 rounded-xl px-3 py-1.5 transition cursor-pointer hover:text-[var(--mt-text)]"
          style="background-color: var(--mt-sub-alt);"
          title="Open Command Line (Esc / Ctrl+Shift+P)"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span><kbd class="font-bold">esc</kbd> - commands</span>
        </button>
      </div>

      <!-- Caps Lock Warning Badge -->
      <div id="mt-caps-warning" class="hidden items-center gap-1.5 rounded-xl px-3 py-1 text-xs font-bold animate-bounce shadow-lg" style="background-color: var(--mt-main); color: var(--mt-bg);">
        <span>⇪</span>
        <span>Caps Lock is ON</span>
      </div>

      <!-- Quick Settings Buttons (Sound, Caret) -->
      <div class="flex items-center gap-2">
        <!-- Switch Sound Selector -->
        <button
          type="button"
          id="mt-sound-cycle-btn"
          class="flex items-center gap-1.5 rounded-xl px-2.5 py-1.5 transition cursor-pointer hover:text-[var(--mt-text)]"
          style="background-color: var(--mt-sub-alt);"
          title="Switch Sound Profile"
        >
          <span id="mt-sound-icon">🔊</span>
          <span id="mt-sound-label" class="hidden md:inline font-bold">clicky</span>
        </button>

        <!-- Caret Style Switcher -->
        <button
          type="button"
          id="mt-caret-cycle-btn"
          class="flex items-center gap-1.5 rounded-xl px-2.5 py-1.5 transition cursor-pointer hover:text-[var(--mt-text)]"
          style="background-color: var(--mt-sub-alt);"
          title="Cycle Caret Style (Line, Block, Underline, Outline, Carrot)"
        >
