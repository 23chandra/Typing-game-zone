---
// Virtual Keyboard & Mobile Input Bar for Responsive Touch Devices & Tablets
// Supports international keyboard layouts: QWERTY, AZERTY, QWERTZ, Dvorak, Colemak
---

<div class="mt-3 flex flex-col items-center gap-2.5 w-full select-none" id="virtual-keyboard-root">
  <!-- Mode Switcher & Mobile Input Bar Container -->
  <div class="w-full max-w-2xl px-1">
    <!-- Top Bar: Mode Switcher + Layout Switcher -->
    <div class="rounded-xl border border-hairline bg-canvas p-2 sm:p-3 shadow-level-1">
      <div class="flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono text-mute mb-2">
        <!-- Input Mode Selector -->
        <div class="flex items-center gap-1 bg-canvas-soft p-0.5 rounded-lg border border-hairline" id="vk-mode-switcher">
          <button
            type="button"
            id="vk-mode-touch-btn"
            class="vk-mode-btn active px-2.5 py-1 rounded-md text-[10px] font-bold transition cursor-pointer"
            style="background-color: var(--site-primary, #e2b714); color: var(--site-on-primary, #323437);"
          >
            🎮 Touch Keys
          </button>
          <button
            type="button"
            id="vk-mode-native-btn"
            class="vk-mode-btn px-2.5 py-1 rounded-md text-[10px] font-bold text-mute hover:text-ink transition cursor-pointer"
          >
            📱 Phone Keyboard
          </button>
        </div>
        
        <!-- Layout Switcher Pills -->
        <div class="flex items-center gap-1 overflow-x-auto no-scrollbar max-w-full pb-0.5" id="vk-layout-switcher">
          <span class="text-[9px] uppercase font-bold text-mute whitespace-nowrap">Layout:</span>
          <button type="button" data-layout="qwerty" class="vk-layout-btn active px-2 py-0.5 rounded text-[10px] font-bold border transition cursor-pointer whitespace-nowrap" style="background-color: var(--site-primary, #e2b714); color: var(--site-on-primary, #323437); border-color: var(--site-primary, #e2b714);">QWERTY</button>
          <button type="button" data-layout="azerty" class="vk-layout-btn px-2 py-0.5 rounded text-[10px] font-bold border border-hairline bg-canvas-soft text-mute hover:text-ink transition cursor-pointer whitespace-nowrap">AZERTY</button>
          <button type="button" data-layout="qwertz" class="vk-layout-btn px-2 py-0.5 rounded text-[10px] font-bold border border-hairline bg-canvas-soft text-mute hover:text-ink transition cursor-pointer whitespace-nowrap">QWERTZ</button>
          <button type="button" data-layout="dvorak" class="vk-layout-btn px-2 py-0.5 rounded text-[10px] font-bold border border-hairline bg-canvas-soft text-mute hover:text-ink transition cursor-pointer whitespace-nowrap">DVORAK</button>
          <button type="button" data-layout="hindi" class="vk-layout-btn px-2 py-0.5 rounded text-[10px] font-bold border border-hairline bg-canvas-soft text-mute hover:text-ink transition cursor-pointer whitespace-nowrap">हिन्दी</button>
          <button type="button" data-layout="russian" class="vk-layout-btn px-2 py-0.5 rounded text-[10px] font-bold border border-hairline bg-canvas-soft text-mute hover:text-ink transition cursor-pointer whitespace-nowrap">Русский</button>
          <button type="button" data-layout="arabic" class="vk-layout-btn px-2 py-0.5 rounded text-[10px] font-bold border border-hairline bg-canvas-soft text-mute hover:text-ink transition cursor-pointer whitespace-nowrap">العربية</button>
        </div>
      </div>

      <!-- Native Phone Soft Keyboard Helper Input (shown or focused when native mode is chosen) -->
      <div id="vk-native-input-box" class="mb-2 hidden">
        <div class="relative w-full">
          <input
            type="text"
            id="mobile-game-input"
            class="w-full rounded-xl border border-hairline bg-canvas-soft px-4 py-2.5 text-center text-sm font-mono text-ink shadow-inner focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20 cursor-text"
            placeholder="Type here with phone keyboard..."
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
          />
          <span class="absolute right-3 top-2.5 text-xs text-mute pointer-events-none">⌨️</span>
        </div>
        <p class="text-[10px] font-mono text-mute text-center mt-1">Tap above to pop open your phone's native keyboard.</p>
      </div>

      <!-- Key Rows Container (Dynamic Layout Matrix - 4 Rows with dedicated Spacebar row) -->
      <div id="vk-rows-container" class="flex flex-col gap-1 sm:gap-1.5 font-mono text-xs w-full">
        <!-- Row 1 -->
        <div class="flex justify-center gap-1 sm:gap-1.5 w-full" id="vk-row-1">
          {['Q', 'W', 'E', 'R', 'T', 'Y', 'U', 'I', 'O', 'P'].map(k => (
            <button
              type="button"
              data-virtual-key={k.toLowerCase()}
              class="virtual-key-btn flex-1 min-w-[28px] max-w-[48px] h-9 sm:h-10 flex items-center justify-center rounded-lg bg-canvas-soft border border-hairline font-bold text-ink text-[11px] sm:text-xs shadow-level-1 hover:bg-canvas-soft-2 active:scale-95 active:bg-ink active:text-on-primary transition cursor-pointer p-0 select-none touch-manipulation"
            >
              {k}
            </button>
          ))}
        </div>
        <!-- Row 2 -->
        <div class="flex justify-center gap-1 sm:gap-1.5 w-full" id="vk-row-2">
          {['A', 'S', 'D', 'F', 'G', 'H', 'J', 'K', 'L', ';'].map(k => (
            <button
              type="button"
              data-virtual-key={k.toLowerCase()}
              class={`virtual-key-btn flex-1 min-w-[28px] max-w-[48px] h-9 sm:h-10 flex items-center justify-center rounded-lg bg-canvas-soft border font-bold text-[11px] sm:text-xs shadow-level-1 hover:bg-canvas-soft-2 active:scale-95 active:bg-ink active:text-on-primary transition cursor-pointer p-0 select-none touch-manipulation ${
                ['F', 'J'].includes(k) ? 'border-link text-link underline font-extrabold' : 'border-hairline text-ink'
              }`}
            >
              {k}
            </button>
          ))}
        </div>
        <!-- Row 3 (Backspace + 9 Letters) -->
        <div class="flex justify-center gap-1 sm:gap-1.5 w-full" id="vk-row-3">
          <button
            type="button"
            data-virtual-key="backspace"
            class="virtual-key-btn flex-initial min-w-[34px] sm:min-w-[48px] h-9 sm:h-10 px-1.5 sm:px-2 flex items-center justify-center rounded-lg bg-canvas-soft border border-hairline font-bold text-xs text-error shadow-level-1 hover:bg-canvas-soft-2 active:scale-95 active:bg-error active:text-white transition cursor-pointer select-none touch-manipulation"
            title="Backspace"
          >
            ⌫
          </button>
          {['Z', 'X', 'C', 'V', 'B', 'N', 'M', ',', '.'].map(k => (
            <button
              type="button"
              data-virtual-key={k.toLowerCase()}
              class="virtual-key-btn flex-1 min-w-[28px] max-w-[48px] h-9 sm:h-10 flex items-center justify-center rounded-lg bg-canvas-soft border border-hairline font-bold text-ink text-[11px] sm:text-xs shadow-level-1 hover:bg-canvas-soft-2 active:scale-95 active:bg-ink active:text-on-primary transition cursor-pointer p-0 select-none touch-manipulation"
            >
              {k}
            </button>
          ))}
        </div>
        <!-- Row 4 (Dedicated Wide SPACE Bar Row) -->
        <div class="flex justify-center items-center gap-1.5 sm:gap-2 w-full mt-0.5" id="vk-row-4">
          <button
            type="button"
            data-virtual-key="Escape"
            class="virtual-key-btn flex-initial min-w-[42px] sm:min-w-[54px] h-9 sm:h-10 px-2 flex items-center justify-center rounded-lg bg-canvas-soft border border-hairline font-bold text-[10px] sm:text-[11px] text-mute shadow-level-1 hover:bg-canvas-soft-2 active:scale-95 transition cursor-pointer select-none touch-manipulation"
            title="Pause game"
          >
            ESC
          </button>
          <button
            type="button"
            data-virtual-key=" "
            class="virtual-key-btn flex-1 max-w-sm h-9 sm:h-10 px-4 flex items-center justify-center rounded-lg bg-canvas-soft border border-hairline font-bold text-xs text-ink shadow-level-1 hover:bg-canvas-soft-2 active:scale-95 active:bg-ink active:text-on-primary transition cursor-pointer select-none touch-manipulation"
          >
            ␣ SPACE
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { KEYBOARD_LAYOUTS } from '../lib/wordLists';
  import { soundEngine } from '../lib/soundEngine';

  function initVirtualKeyboard() {
    const layoutBtns = document.querySelectorAll('.vk-layout-btn');
    const row1 = document.getElementById('vk-row-1');
    const row2 = document.getElementById('vk-row-2');
    const row3 = document.getElementById('vk-row-3');
    const rowsContainer = document.getElementById('vk-rows-container');
    const nativeInputBox = document.getElementById('vk-native-input-box');
    const mobileInput = document.getElementById('mobile-game-input') as HTMLInputElement | null;
    const modeTouchBtn = document.getElementById('vk-mode-touch-btn');
    const modeNativeBtn = document.getElementById('vk-mode-native-btn');

    let currentInputMode: 'touch' | 'native' = 'touch';

    const setInputMode = (mode: 'touch' | 'native') => {
      currentInputMode = mode;
      if (mode === 'native') {
        nativeInputBox?.classList.remove('hidden');
        modeNativeBtn?.classList.add('active');
        if (modeNativeBtn) {
          modeNativeBtn.style.backgroundColor = 'var(--site-primary, #e2b714)';
          modeNativeBtn.style.color = 'var(--site-on-primary, #323437)';
        }
        modeTouchBtn?.classList.remove('active');
        if (modeTouchBtn) {
          modeTouchBtn.style.backgroundColor = '';
          modeTouchBtn.style.color = '';
        }
        try { mobileInput?.focus({ preventScroll: true }); } catch { mobileInput?.focus(); }
      } else {
        nativeInputBox?.classList.add('hidden');
        modeTouchBtn?.classList.add('active');
        if (modeTouchBtn) {
          modeTouchBtn.style.backgroundColor = 'var(--site-primary, #e2b714)';
          modeTouchBtn.style.color = 'var(--site-on-primary, #323437)';
        }
        modeNativeBtn?.classList.remove('active');
        if (modeNativeBtn) {
          modeNativeBtn.style.backgroundColor = '';
          modeNativeBtn.style.color = '';
        }
        mobileInput?.blur();
      }
    };

    modeTouchBtn?.addEventListener('click', () => setInputMode('touch'));
    modeNativeBtn?.addEventListener('click', () => setInputMode('native'));

    const savedLayout = localStorage.getItem('typing_game_zone_layout');
    const currentLang = localStorage.getItem('typing_game_zone_lang') || 'en';
    const langToLayout: Record<string, string> = {
      hi: 'hindi',
      ru: 'russian',
      ar: 'arabic',
      de: 'qwertz',
      fr: 'azerty',
      en: 'qwerty'
    };
    let curLayout = savedLayout || langToLayout[currentLang] || 'qwerty';

    rowsContainer?.addEventListener('pointerdown', (e) => {
      const btn = (e.target as HTMLElement).closest('.virtual-key-btn');
      if (!btn) return;
      e.preventDefault();
      const key = btn.getAttribute('data-virtual-key');
      if (!key) return;

      soundEngine.initContext();
      soundEngine.playKey(key === ' ');

      const keyVal = key === 'backspace' ? 'Backspace' : key;
      window.dispatchEvent(new CustomEvent('typing:virtual-key', {
        detail: { key: keyVal }
      }));
    });

    const renderLayout = (layoutKey: string) => {
      const def = KEYBOARD_LAYOUTS[layoutKey] || KEYBOARD_LAYOUTS.qwerty;
      if (!row1 || !row2 || !row3) return;

      // Update row 1
      row1.innerHTML = def.rows[0].map(k => `
        <button
          type="button"
          data-virtual-key="${k.toLowerCase()}"
          class="virtual-key-btn flex-1 min-w-[28px] max-w-[48px] h-9 sm:h-10 flex items-center justify-center rounded-lg bg-canvas-soft border border-hairline font-bold text-ink text-[11px] sm:text-xs shadow-level-1 hover:bg-canvas-soft-2 active:scale-95 active:bg-ink active:text-on-primary transition cursor-pointer p-0 select-none touch-manipulation"
        >
          ${k.toUpperCase()}
        </button>
      `).join('');

      // Update row 2
      row2.innerHTML = def.rows[1].map(k => {
        const isHoming = ['f', 'j', 'u', 'h', 't', 'n'].includes(k.toLowerCase());
        return `
        <button
          type="button"
          data-virtual-key="${k.toLowerCase()}"
          class="virtual-key-btn flex-1 min-w-[28px] max-w-[48px] h-9 sm:h-10 flex items-center justify-center rounded-lg bg-canvas-soft border ${isHoming ? 'border-link text-link underline font-extrabold' : 'border-hairline text-ink'} font-bold text-[11px] sm:text-xs shadow-level-1 hover:bg-canvas-soft-2 active:scale-95 active:bg-ink active:text-on-primary transition cursor-pointer p-0 select-none touch-manipulation"
        >
          ${k.toUpperCase()}
        </button>
      `;}).join('');

      // Update row 3 (Backspace + Row 2 characters)
      const midKeys = def.rows[2].map(k => `
        <button
          type="button"
          data-virtual-key="${k.toLowerCase()}"
          class="virtual-key-btn flex-1 min-w-[28px] max-w-[48px] h-9 sm:h-10 flex items-center justify-center rounded-lg bg-canvas-soft border border-hairline font-bold text-ink text-[11px] sm:text-xs shadow-level-1 hover:bg-canvas-soft-2 active:scale-95 active:bg-ink active:text-on-primary transition cursor-pointer p-0 select-none touch-manipulation"
        >
          ${k.toUpperCase()}
        </button>
      `).join('');

      row3.innerHTML = `
        <button
          type="button"
          data-virtual-key="backspace"
          class="virtual-key-btn flex-initial min-w-[34px] sm:min-w-[48px] h-9 sm:h-10 px-1.5 sm:px-2 flex items-center justify-center rounded-lg bg-canvas-soft border border-hairline font-bold text-xs text-error shadow-level-1 hover:bg-canvas-soft-2 active:scale-95 active:bg-error active:text-white transition cursor-pointer select-none touch-manipulation"
          title="Backspace"
        >
          ⌫
        </button>
        ${midKeys}
      `;

      // Update active layout button state
      layoutBtns.forEach(btn => {
        const lKey = btn.getAttribute('data-layout');
        if (lKey === layoutKey) {
          btn.classList.add('active');
          (btn as HTMLElement).style.backgroundColor = 'var(--site-primary, #e2b714)';
          (btn as HTMLElement).style.color = 'var(--site-on-primary, #323437)';
          (btn as HTMLElement).style.borderColor = 'var(--site-primary, #e2b714)';
        } else {
          btn.classList.remove('active');
          (btn as HTMLElement).style.backgroundColor = '';
          (btn as HTMLElement).style.color = '';
          (btn as HTMLElement).style.borderColor = '';
        }
      });
    };

    layoutBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const l = btn.getAttribute('data-layout');
        if (l && KEYBOARD_LAYOUTS[l]) {
          curLayout = l;
          try { localStorage.setItem('typing_game_zone_layout', l); } catch {}
          renderLayout(l);
          window.dispatchEvent(new CustomEvent('typing:layout-change', { detail: { layout: l } }));
        }
      });
    });

    // Auto-sync virtual keyboard layout with selected language
    window.addEventListener('typing:language-change', (e: any) => {
      const lang = e.detail?.lang;
      if (!lang) return;
      const langToLayout: Record<string, string> = {
        hi: 'hindi',
        ru: 'russian',
        ar: 'arabic',
        de: 'qwertz',
        fr: 'azerty',
        en: 'qwerty'
      };
      if (langToLayout[lang] && KEYBOARD_LAYOUTS[langToLayout[lang]]) {
        curLayout = langToLayout[lang];
        renderLayout(curLayout);
      }
    });

    renderLayout(curLayout);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVirtualKeyboard);
  } else {
    initVirtualKeyboard();
  }
  document.addEventListener('astro:page-load', initVirtualKeyboard);
</script>
