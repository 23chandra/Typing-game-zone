---
// Modal for Level Clear, Game Over, and Victory
---

<div id="game-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-3 sm:p-4 hidden">
  <div class="relative w-full max-w-md max-h-[92dvh] overflow-y-auto overscroll-contain rounded-2xl border border-hairline bg-canvas p-4 sm:p-6 shadow-level-5 text-center animate-in fade-in zoom-in-95 duration-200">
    
    <!-- Top-Right Close 'X' Button -->
    <button
      id="modal-close-btn"
      type="button"
      class="absolute top-3 right-3 sm:top-4 sm:right-4 flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-full border border-hairline bg-canvas-soft text-mute hover:text-ink hover:bg-canvas active:scale-95 transition cursor-pointer z-10"
      title="Close popup (Esc)"
      aria-label="Close modal"
    >
      <svg class="h-4 w-4 sm:h-4.5 sm:w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Status Icon & Grade -->
    <div class="mx-auto flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-2xl bg-canvas-soft border border-hairline shadow-level-2 mb-2 sm:mb-3">
      <span id="modal-status-icon" class="text-2xl sm:text-3xl">🎉</span>
    </div>

    <!-- Title & Subtitle -->
    <h3 id="modal-title" class="text-xl sm:text-2xl font-bold tracking-tight text-ink" data-i18n="game.levelCleared">Level Cleared!</h3>
    <p id="modal-subtitle" class="text-xs text-body mt-1">Excellent typing rhythm and precision.</p>

    <!-- Grade Rank Pill -->
    <div class="mt-3 sm:mt-4 flex items-center justify-center gap-2">
      <span class="text-[11px] sm:text-xs font-mono uppercase text-mute" data-i18n="game.performanceGrade">Performance Grade:</span>
      <span id="modal-grade-badge" class="rounded-full bg-emerald-500 text-white font-mono font-bold px-3 py-0.5 text-xs shadow-level-1">
        RANK S
      </span>
    </div>

    <!-- Stats Grid Breakdown -->
    <div class="mt-4 sm:mt-6 grid grid-cols-2 gap-2.5 sm:gap-3 rounded-xl bg-canvas-soft p-3 sm:p-4 border border-hairline font-mono text-left text-xs">
      <div>
        <span class="text-[10px] text-mute uppercase" data-i18n="st.wpm">Net WPM</span>
        <div id="modal-wpm" class="text-base sm:text-lg font-bold text-ink">0</div>
      </div>
      <div>
        <span class="text-[10px] text-mute uppercase" data-i18n="st.acc">Accuracy</span>
        <div id="modal-accuracy" class="text-base sm:text-lg font-bold text-ink">100%</div>
      </div>
      <div>
        <span class="text-[10px] text-mute uppercase" data-i18n="game.score">Final Score</span>
        <div id="modal-score" class="text-base sm:text-lg font-bold text-success">0</div>
      </div>
      <div>
        <span class="text-[10px] text-mute uppercase" data-i18n="nav.activeStreak">Max Streak</span>
        <div id="modal-streak" class="text-base sm:text-lg font-bold text-warning">0</div>
      </div>
      <div>
        <span class="text-[10px] text-mute uppercase">Total Errors</span>
        <div id="modal-errors" class="text-base sm:text-lg font-bold text-error">0</div>
      </div>
      <div>
        <span class="text-[10px] text-mute uppercase" data-i18n="st.timeElapsed">Time Elapsed</span>
        <div id="modal-time" class="text-base sm:text-lg font-bold text-body">0s</div>
      </div>
    </div>

    <!-- New High Score Alert -->
    <div id="modal-new-record" class="mt-2.5 hidden items-center justify-center gap-1.5 text-xs font-mono text-warning font-semibold">
      <span data-i18n="game.newRecord">👑 NEW HIGH SCORE RECORD!</span>
    </div>

    <!-- XP Earned Telemetry -->
    <div id="modal-xp-earned" class="mt-1.5 hidden items-center justify-center gap-1.5 text-xs font-mono text-link font-bold">
      <span id="modal-xp-text">+50 XP Earned</span>
    </div>

    <!-- Action Buttons -->
    <div class="mt-5 sm:mt-6 flex flex-wrap items-center justify-center gap-2 sm:gap-3">
      <button
        id="modal-next-btn"
        type="button"
        class="inline-flex items-center justify-center rounded-full bg-ink px-5 sm:px-6 py-2.5 text-xs sm:text-sm font-medium text-on-primary shadow-level-2 transition hover:opacity-90 active:scale-95 min-h-[42px] cursor-pointer"
      >
        <span data-i18n="game.nextLevel">Next Level →</span>
      </button>

      <button
        id="modal-retry-btn"
        type="button"
        class="inline-flex items-center justify-center rounded-full border border-hairline bg-canvas px-4 sm:px-5 py-2.5 text-xs sm:text-sm font-medium text-ink shadow-level-1 transition hover:bg-canvas-soft active:scale-95 min-h-[42px] cursor-pointer"
      >
        <span data-i18n="game.tryAgain">Try Again</span>
      </button>

      <button
        id="modal-dismiss-btn"
        type="button"
        class="inline-flex items-center justify-center rounded-full border border-hairline bg-canvas px-4 sm:px-5 py-2.5 text-xs sm:text-sm font-medium text-body hover:text-ink shadow-level-1 transition hover:bg-canvas-soft active:scale-95 min-h-[42px] cursor-pointer"
        title="Close this popup"
      >
        <span>Close ✕</span>
      </button>

      <a
        href="/"
        class="inline-flex items-center justify-center rounded-full border border-hairline bg-canvas-soft px-4 py-2.5 text-xs sm:text-sm font-medium text-body transition hover:text-ink hover:bg-canvas active:scale-95 min-h-[42px]"
      >
        <span>Hub</span>
      </a>
    </div>
  </div>
</div>
