---
import Layout from '../layouts/Layout.astro';

const seoTitle = 'Terms and Conditions — Typing Game Zone';
const seoDescription = 'Read the official Terms and Conditions for using Typing Game Zone. Understand user guidelines, fair play policies, intellectual property rights, and platform terms.';
const seoKeywords = 'terms and conditions, terms of service, typing game zone terms, typing game rules, fair play typing';

const termsStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'Terms and Conditions — Typing Game Zone',
  'url': 'https://typinggamezone.com/terms',
  'description': seoDescription,
  'publisher': {
    '@type': 'Organization',
    'name': 'Typing Game Zone',
    'url': 'https://typinggamezone.com',
    'contactPoint': {
      '@type': 'ContactPoint',
      'email': 'contact@typinggamezone.com',
      'contactType': 'Legal & Support'
    }
  },
  'breadcrumb': {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Home',
        'item': 'https://typinggamezone.com/'
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'Terms & Conditions',
        'item': 'https://typinggamezone.com/terms'
      }
    ]
  }
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonicalUrl="https://typinggamezone.com/terms"
  structuredData={termsStructuredData}
>
  <div class="py-12 sm:py-16 bg-canvas-soft border-b border-hairline">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-mono text-mute mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-ink transition">Home</a>
        <span>/</span>
        <span class="text-ink font-semibold">Terms & Conditions</span>
      </nav>

      <!-- Page Header -->
      <div class="text-left">
        <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-3.5 py-1 text-xs font-mono text-link shadow-level-1 backdrop-blur mb-4">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>USER AGREEMENT & FAIR PLAY</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-ink leading-tight font-sans">
          Terms & Conditions
        </h1>
        <p class="mt-4 text-sm sm:text-base text-body max-w-2xl leading-relaxed font-sans">
          Please review these Terms and Conditions carefully before using Typing Game Zone. By accessing our games, speed tests, or practice tools, you agree to abide by these terms.
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-4 text-xs font-mono text-mute">
          <span>Effective Date: August 2026</span>
          <span>•</span>
          <span>Last Updated: August 28, 2026</span>
        </div>
      </div>
    </div>
  </div>

  <main class="py-12 sm:py-16 bg-canvas">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

      <!-- Key Terms Overview Box -->
      <div class="rounded-3xl border border-hairline bg-canvas-soft p-6 sm:p-8 mb-12 shadow-level-2">
        <h2 class="text-lg font-bold text-ink mb-4 flex items-center gap-2 font-mono">
          <span>📋</span> Summary of Key Terms
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div class="rounded-2xl border border-hairline bg-canvas p-4">
            <span class="font-bold text-ink block mb-1">🆓 100% Free Personal Use</span>
            <p class="text-mute">Typing Game Zone is free for learners, teachers, and gamers worldwide for personal educational and recreational use.</p>
          </div>
          <div class="rounded-2xl border border-hairline bg-canvas p-4">
            <span class="font-bold text-ink block mb-1">⚡ Fair Play & Anti-Botting</span>
            <p class="text-mute">Using automated keyboard macro bots or malicious scripts to fake scores or distort leaderboards is strictly prohibited.</p>
          </div>
          <div class="rounded-2xl border border-hairline bg-canvas p-4">
            <span class="font-bold text-ink block mb-1">🎮 Intellectual Property</span>
            <p class="text-mute">All original 2D game mechanics, brand assets, logos, and custom code are the property of Typing Game Zone.</p>
          </div>
          <div class="rounded-2xl border border-hairline bg-canvas p-4">
            <span class="font-bold text-ink block mb-1">📬 Inquiries & Support</span>
            <p class="text-mute">Direct legal inquiries, licensing questions, or concerns to <a href="mailto:contact@typinggamezone.com" class="text-link underline">contact@typinggamezone.com</a>.</p>
          </div>
        </div>
      </div>

      <!-- Table of Contents -->
      <div class="rounded-2xl border border-hairline bg-canvas-soft p-6 mb-12 text-xs font-mono">
        <h3 class="font-bold text-ink uppercase tracking-wider mb-3">Table of Contents</h3>
        <ol class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-body list-decimal list-inside">
          <li><a href="#term-1" class="hover:text-link transition">1. Acceptance of Terms</a></li>
          <li><a href="#term-2" class="hover:text-link transition">2. Use License & Access</a></li>
          <li><a href="#term-3" class="hover:text-link transition">3. Intellectual Property Rights</a></li>
          <li><a href="#term-4" class="hover:text-link transition">4. Fair Play & User Conduct</a></li>
          <li><a href="#term-5" class="hover:text-link transition">5. Disclaimer of Warranties</a></li>
          <li><a href="#term-6" class="hover:text-link transition">6. Limitation of Liability</a></li>
          <li><a href="#term-7" class="hover:text-link transition">7. External Links & Third Parties</a></li>
          <li><a href="#term-8" class="hover:text-link transition">8. Modifications to Service & Terms</a></li>
          <li><a href="#term-9" class="hover:text-link transition">9. Governing Law</a></li>
          <li><a href="#term-10" class="hover:text-link transition">10. Contact Information</a></li>
        </ol>
      </div>

      <!-- Terms Content Sections -->
      <div class="space-y-12 text-sm leading-relaxed text-body font-sans">
        
        <!-- Section 1 -->
        <section id="term-1" class="scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4 font-mono">
            1. Acceptance of Terms
          </h2>
          <p class="mb-3">
            These Terms and Conditions ("Terms") constitute a legally binding agreement between you ("User", "you", or "your") and <strong>Typing Game Zone</strong> ("we", "us", or "our"), governing your access to and use of <a href="https://typinggamezone.com" class="text-link hover:underline">typinggamezone.com</a> and all associated games, tools, speed tests, and practice modules (collectively, the "Service").
          </p>
          <p>
            By visiting, browsing, playing, or utilizing any feature of Typing Game Zone, you confirm that you have read, understood, and agreed to be bound by these Terms and our <a href="/privacy" class="text-link underline">Privacy Policy</a>. If you do not agree with any part of these Terms, please discontinue use immediately.
          </p>
        </section>

        <!-- Section 2 -->
        <section id="term-2" class="scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4 font-mono">
            2. Use License & Access
          </h2>
          <p class="mb-3">
            We grant you a non-exclusive, non-transferable, revocable, personal license to access and play our 2D typing games and use our typing speed testing and practice tools strictly for personal, non-commercial, educational, and entertainment purposes.
          </p>
          <p class="mb-3">Under this license, you may NOT:</p>
          <ul class="list-disc list-inside space-y-1.5 ml-2 text-mute mb-3">
            <li>Modify, reverse engineer, decompile, or disassemble any game engine or compiled scripts on the platform.</li>
            <li>Frame, mirror, or repackage the Service on any other server or domain without prior written authorization.</li>
            <li>Use the Service for any commercial exploitation, reselling, or unauthorized paid redistribution.</li>
            <li>Circumvent or attempt to bypass any security or anti-tamper mechanisms.</li>
          </ul>
        </section>

        <!-- Section 3 -->
        <section id="term-3" class="scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4 font-mono">
            3. Intellectual Property Rights
          </h2>
          <p class="mb-3">
            All original game concepts, 2D sprites, graphical user interfaces, audio synthesizer algorithms, visual themes, brand names, logos, typography arrangements, and software code on Typing Game Zone are owned by or licensed to Typing Game Zone and are protected by international copyright, trademark, and intellectual property laws.
          </p>
          <p>
            You agree not to copy, reproduce, distribute, or create derivative works from our games or platform components without explicit written permission.
          </p>
        </section>

        <!-- Section 4 -->
        <section id="term-4" class="scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4 font-mono">
            4. Fair Play & User Conduct
          </h2>
          <p class="mb-3">
            Typing Game Zone is dedicated to fostering genuine keyboard skill mastery, honest competition, and self-improvement. To protect the experience of our community, you agree NOT to engage in:
          </p>
          <ul class="list-disc list-inside space-y-2 ml-2 text-mute mb-3">
            <li><strong>Automated Keystroke Injection:</strong> Using bots, headless browser automations, macro scripts, or auto-typers to falsify typing speeds (WPM), accuracy, or game high scores.</li>
            <li><strong>Leaderboard Tampering:</strong> Injecting manipulated telemetry payloads or spoofing local state values to achieve illegitimate ranking positions.</li>
            <li><strong>Network Disruption:</strong> Attempting DDoS attacks, overwhelming server bandwidth, or interfering with page loading for other typists.</li>
            <li><strong>Exploiting Bugs:</strong> Intentionally abusing software glitches to circumvent gameplay rules rather than reporting them responsibly.</li>
          </ul>
          <p>
            We reserve the right to disqualify fraudulent scores or restrict access to offending network addresses without notice.
          </p>
        </section>

        <!-- Section 5 -->
        <section id="term-5" class="scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4 font-mono">
            5. Disclaimer of Warranties
          </h2>
          <p class="mb-3">
            The Service and all games, sound synthesis modules, and tools are provided on an <strong>"AS IS"</strong> and <strong>"AS AVAILABLE"</strong> basis without warranties of any kind, either express or implied, including but not limited to warranties of merchantability, fitness for a particular purpose, uptime availability, or non-infringement.
          </p>
          <p>
            While we strive for flawless 60 FPS performance and bug-free gameplay across modern browsers, we do not warrant that the website will be uninterrupted, error-free, or compatible with obsolete legacy hardware.
          </p>
        </section>

        <!-- Section 6 -->
        <section id="term-6" class="scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4 font-mono">
            6. Limitation of Liability
          </h2>
          <p>
            To the maximum extent permitted by applicable law, in no event shall Typing Game Zone, its creators, contributors, or affiliates be liable for any direct, indirect, incidental, special, consequential, or punitive damages arising from your access to, use of, or inability to use the Service, including but not limited to loss of data, loss of local browser storage, device malfunction, or repetitive strain injury from keyboard over-exertion.
          </p>
        </section>

        <!-- Section 7 -->
        <section id="term-7" class="scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4 font-mono">
            7. External Links & Third Parties
          </h2>
          <p>
            Our website may contain links to third-party web resources (such as Google Fonts or external documentation). We do not control or endorse the content, privacy policies, or practices of third-party platforms and accept no responsibility for them.
          </p>
        </section>

        <!-- Section 8 -->
        <section id="term-8" class="scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4 font-mono">
            8. Modifications to Service & Terms
          </h2>
          <p class="mb-3">
            We reserve the right to update, modify, add, or discontinue any game, feature, or aspect of Typing Game Zone at any time without prior notice.
          </p>
          <p>
            We may likewise modify these Terms periodically. Updates become effective immediately upon posting. Your continued use of the website following any changes signifies your acceptance of the revised Terms.
          </p>
        </section>

        <!-- Section 9 -->
        <section id="term-9" class="scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4 font-mono">
            9. Governing Law & Dispute Resolution
          </h2>
          <p>
            These Terms shall be governed by and construed in accordance with applicable general principles of law without regard to conflict of law principles. Any dispute arising out of these Terms shall first be attempted to be resolved amicably through direct informal discussion with our support team.
          </p>
        </section>

        <!-- Section 10 -->
        <section id="term-10" class="scroll-mt-24">
          <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4 font-mono">
            10. Contact Information
          </h2>
          <p class="mb-6">
            If you have any questions, legal inquiries, or licensing requests regarding these Terms and Conditions, please contact us directly:
          </p>

          <!-- Contact Email Card -->
          <div class="rounded-3xl border border-hairline bg-canvas-soft p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 shadow-level-2">
            <div>
              <span class="text-xs font-mono text-mute uppercase font-bold block mb-1">Official Legal & Support Desk</span>
              <span class="text-lg sm:text-xl font-bold text-ink font-mono block">contact@typinggamezone.com</span>
              <span class="text-xs text-mute mt-1 block">Typing Game Zone • Terms & Inquiries</span>
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <a
                href="mailto:contact@typinggamezone.com?subject=Terms%20Inquiry%20-%20Typing%20Game%20Zone"
                class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-xs font-bold shadow-level-2 transition hover:opacity-90 active:scale-95"
                style="background-color: var(--site-primary, #e2b714); color: var(--site-on-primary, #323437);"
              >
                <span>✉️ Send Email</span>
              </a>
              <button
                type="button"
                id="copy-terms-email-btn"
                class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas px-4 py-2.5 text-xs font-mono font-medium text-ink transition hover:bg-canvas-soft-2 cursor-pointer"
              >
                <span id="copy-terms-btn-text">📋 Copy Email</span>
              </button>
            </div>
          </div>
        </section>

      </div>

      <!-- Bottom Related Links -->
      <div class="mt-16 pt-8 border-t border-hairline flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-mute">
        <div class="flex flex-wrap items-center gap-4">
          <a href="/privacy" class="hover:text-ink transition">Privacy Policy →</a>
          <a href="/about" class="hover:text-ink transition">About Us →</a>
          <a href="/contact" class="hover:text-ink transition">Contact Us →</a>
        </div>
        <a href="#top" class="hover:text-ink transition">Back to Top ↑</a>
      </div>

    </div>
  </main>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-terms-email-btn');
  const copyBtnText = document.getElementById('copy-terms-btn-text');

  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText('contact@typinggamezone.com').then(() => {
      if (copyBtnText) copyBtnText.textContent = '✓ Copied!';
      setTimeout(() => {
        if (copyBtnText) copyBtnText.textContent = '📋 Copy Email';
      }, 2000);
    });
  });
</script>
