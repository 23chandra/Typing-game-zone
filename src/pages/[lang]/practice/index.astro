---
import Layout from '../../../layouts/Layout.astro';
import PracticeLabWidget from '../../../components/PracticeLabWidget.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../../i18n/config';
import { t } from '../../../i18n/utils';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map(lang => ({
    params: { lang },
    props: { lang }
  }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const currentLocale = lang || 'en';

const seoTitle = `${t('prac.title', currentLocale)} — ${t('seo.practiceTitle', currentLocale)}`;
const seoDescription = t('seo.practiceDescription', currentLocale);

const practiceStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': t('nav.home', currentLocale),
      'item': `https://typinggamezone.com/${currentLocale}/`
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': t('nav.practiceLab', currentLocale),
      'item': `https://typinggamezone.com/${currentLocale}/practice/`
    }
  ]
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  locale={currentLocale}
  structuredData={practiceStructuredData}
>
  <div class="py-12 sm:py-16 bg-canvas-soft min-h-screen">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="text-center max-w-3xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-3 py-1 text-xs font-mono text-link mb-3 shadow-sm">
          <span class="h-2 w-2 rounded-full animate-ping" style="background-color: var(--site-primary, #e2b714);"></span>
          <span>INTERACTIVE PRACTICE LAB • 100% FREE</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-ink">
          <span data-i18n="prac.title">{t('prac.title', currentLocale)}</span>
        </h1>
        <p class="mt-3 text-sm text-body leading-relaxed" data-i18n="prac.subtitle">
          {t('prac.subtitle', currentLocale)}
        </p>
      </div>

      <!-- Practice Lab Widget -->
      <div class="mb-12">
        <PracticeLabWidget />
      </div>

    </div>
  </div>
</Layout>
