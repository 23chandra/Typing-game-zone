---
import Layout from '../../../layouts/Layout.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../../i18n/config';
import { t } from '../../../i18n/utils';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map(lang => ({
    params: { lang },
    props: { lang }
  }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const currentLocale = lang || 'en';

const seoTitle = `${t('footer.contact', currentLocale)} — ${t('seo.contactTitle', currentLocale)}`;
const seoDescription = t('seo.contactDescription', currentLocale);
const seoKeywords = 'contact typing game zone, typing game support, typing game feedback, typing game bug report, contact typing arcade';

const contactStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  'name': `${t('footer.contact', currentLocale)} — Typing Game Zone`,
  'url': `https://typinggamezone.com/${currentLocale}/contact/`,
  'description': seoDescription,
  'mainEntity': {
    '@type': 'Organization',
    'name': 'Typing Game Zone',
    'url': 'https://typinggamezone.com',
    'email': 'contact@typinggamezone.com',
    'contactPoint': [
      {
        '@type': 'ContactPoint',
        'email': 'contact@typinggamezone.com',
        'contactType': 'Customer Support'
      }
    ]
  },
  'breadcrumb': {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': t('nav.home', currentLocale),
        'item': `https://typinggamezone.com/${currentLocale}/`
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': t('footer.contact', currentLocale),
        'item': `https://typinggamezone.com/${currentLocale}/contact/`
      }
    ]
  }
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  locale={currentLocale}
  structuredData={contactStructuredData}
>
  <div class="py-12 sm:py-20 bg-canvas-soft min-h-screen">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-10">
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-ink">
          {t('footer.contact', currentLocale)}
        </h1>
        <p class="mt-3 text-sm text-body leading-relaxed">
          {t('seo.contactDescription', currentLocale)}
        </p>
      </div>

      <div class="rounded-3xl border border-hairline bg-canvas p-6 sm:p-10 shadow-level-2">
        <form class="space-y-4">
          <div>
            <label class="block text-xs font-mono font-bold text-ink mb-1">Name</label>
            <input
              type="text"
              required
              class="w-full rounded-xl border border-hairline bg-canvas-soft px-4 py-2.5 text-xs font-mono text-ink focus:border-link focus:outline-none"
              placeholder="Your name"
            />
          </div>
          <div>
            <label class="block text-xs font-mono font-bold text-ink mb-1">Email</label>
            <input
              type="email"
              required
              class="w-full rounded-xl border border-hairline bg-canvas-soft px-4 py-2.5 text-xs font-mono text-ink focus:border-link focus:outline-none"
              placeholder="you@example.com"
            />
          </div>
          <div>
            <label class="block text-xs font-mono font-bold text-ink mb-1">Message</label>
            <textarea
              rows="4"
              required
              class="w-full rounded-xl border border-hairline bg-canvas-soft px-4 py-2.5 text-xs font-mono text-ink focus:border-link focus:outline-none"
              placeholder="How can we help?"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full rounded-xl py-3 text-xs font-bold font-mono transition shadow-level-2 active:scale-95 cursor-pointer"
            style="background-color: var(--site-primary, #e2b714); color: var(--site-on-primary, #323437);"
          >
            Send Message
          </button>
        </form>
      </div>

    </div>
  </div>
</Layout>
