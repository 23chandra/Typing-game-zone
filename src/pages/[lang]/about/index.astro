---
import Layout from '../../../layouts/Layout.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../../i18n/config';
import { t, getLocaleUrl } from '../../../i18n/utils';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map(lang => ({
    params: { lang },
    props: { lang }
  }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const currentLocale = lang || 'en';

const seoTitle = `${t('footer.about', currentLocale)} — ${t('seo.aboutTitle', currentLocale)}`;
const seoDescription = t('seo.aboutDescription', currentLocale);

const aboutStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  'name': t('footer.about', currentLocale),
  'url': `https://typinggamezone.com/${currentLocale}/about/`,
  'description': seoDescription,
  'breadcrumb': {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': t('nav.home', currentLocale),
        'item': `https://typinggamezone.com/${currentLocale}/`
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': t('footer.about', currentLocale),
        'item': `https://typinggamezone.com/${currentLocale}/about/`
      }
    ]
  }
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  locale={currentLocale}
  structuredData={aboutStructuredData}
>
  <div class="py-12 sm:py-20 bg-canvas-soft min-h-screen">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      
      <!-- Top Eyebrow -->
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-3.5 py-1 text-xs font-mono text-link mb-3 shadow-sm">
          <span>🚀 {t('footer.about', currentLocale).toUpperCase()}</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-ink">
          Typing Game Zone
        </h1>
        <p class="mt-3 text-sm sm:text-base text-body leading-relaxed max-w-2xl mx-auto">
          {t('seo.aboutDescription', currentLocale)}
        </p>
      </div>

      <!-- Core Mission Card -->
      <div class="rounded-3xl border border-hairline bg-canvas p-6 sm:p-10 shadow-level-2 mb-8">
        <h2 class="text-xl font-bold text-ink mb-4 flex items-center gap-2">
          <span>🎯</span> <span>Our Global Mission</span>
        </h2>
        <p class="text-sm text-body leading-relaxed mb-4">
          Typing Game Zone was created with one simple conviction: mastering the keyboard should be engaging, rewarding, and accessible to everyone around the world in their native language.
        </p>
        <p class="text-sm text-body leading-relaxed">
          Instead of repetitive drills, we combine 21 authentic 2D canvas retro arcade games, procedural mechanical keyboard audio synthesis, Monkeytype-grade telemetry, and multi-script typing datasets across 16 global languages.
        </p>
      </div>

      <!-- Key Pillars -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        <div class="rounded-2xl border border-hairline bg-canvas p-5 shadow-level-1">
          <div class="text-2xl mb-2">🎮</div>
          <h3 class="text-sm font-bold text-ink">21 2D Arcade Games</h3>
          <p class="text-xs text-body mt-1">From space shooters and ninja slicing to zombie defense and dungeon platformers.</p>
        </div>
        <div class="rounded-2xl border border-hairline bg-canvas p-5 shadow-level-1">
          <div class="text-2xl mb-2">🌐</div>
          <h3 class="text-sm font-bold text-ink">16 Native Languages</h3>
          <p class="text-xs text-body mt-1">True native datasets, Unicode grapheme segmentation, IME composition and Arabic RTL support.</p>
        </div>
        <div class="rounded-2xl border border-hairline bg-canvas p-5 shadow-level-1">
          <div class="text-2xl mb-2">🔊</div>
          <h3 class="text-sm font-bold text-ink">Mechanical Switch Audio</h3>
          <p class="text-xs text-body mt-1">Real-time synthesized Cherry MX Blue, Holy Panda, Red linear, and typewriter click sounds.</p>
        </div>
      </div>

      <!-- CTA Row -->
      <div class="text-center pt-4">
        <a
          href={getLocaleUrl('/arcade', currentLocale)}
          class="inline-flex items-center gap-2 rounded-full px-6 py-3 text-xs sm:text-sm font-bold shadow-level-2 transition hover:opacity-90 active:scale-95"
          style="background-color: var(--site-primary, #e2b714); color: var(--site-on-primary, #323437);"
        >
          <span>{t('hero.browseGames', currentLocale)}</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</Layout>
