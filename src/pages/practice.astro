---
import Layout from '../layouts/Layout.astro';
import { WORD_LISTS } from '../lib/wordLists';
---

<Layout
  title="Touch Typing Practice Lab & Drills — Typing Game Zone"
  description="Master the keyboard with touch-typing finger placement guides, home row drills, number row practice, and visual heatmap training."
>
  <div class="py-12 sm:py-16 bg-canvas-soft min-h-screen">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-link">Muscle Memory & Technique</span>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-ink mt-2">
          Touch Typing Practice Lab.
        </h1>
        <p class="mt-3 text-sm text-body leading-relaxed">
          Master the home row, eliminate hunt-and-peck habits, and train each finger to strike its designated quadrant automatically without looking down.
        </p>
      </div>

      <!-- Feature Interactive Key Master CTA Card -->
      <div class="relative overflow-hidden rounded-2xl border border-hairline bg-canvas p-8 shadow-level-3 mb-12 flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="max-w-xl">
          <span class="rounded-full bg-canvas-soft text-link border border-hairline px-3 py-1 text-xs font-mono font-semibold">
            RECOMMENDED GAME
          </span>
          <h2 class="text-2xl font-bold text-ink mt-3">Key Master: 3D Keyboard Heatmap Lab</h2>
          <p class="text-xs text-body mt-2 leading-relaxed">
            Experience real-time keystroke ripple waves, finger zone color coding, and accuracy heatmaps on an illuminated interactive keyboard.
          </p>
          <a
            href="/game/key-master"
            class="mt-5 inline-flex items-center gap-2 rounded-full bg-ink px-6 py-2.5 text-xs font-medium text-on-primary shadow-level-2 transition hover:opacity-90 active:scale-95"
          >
            <span>Launch Key Master Lab</span>
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <div class="flex flex-col items-center justify-center rounded-xl bg-canvas-soft p-6 border border-hairline w-full md:w-80 text-center font-mono">
          <div class="text-4xl mb-2">⌨️</div>
          <span class="text-xs font-bold text-ink">Finger Zone Coding</span>
          <span class="text-[10px] text-mute mt-1">Left Pinky (A) • Right Pinky (;)</span>
          <span class="text-[10px] text-mute">Index Home (F & J bumps)</span>
        </div>
      </div>

      <!-- Finger Placement & Quadrant Map -->
      <div class="mb-12 rounded-2xl border border-hairline bg-canvas p-8 shadow-level-2">
        <h3 class="text-lg font-bold text-ink mb-2">Standard Touch Typing Finger Map</h3>
        <p class="text-xs text-body mb-6">Rest both index fingers on the home keys with tactile bumps: <strong>F</strong> and <strong>J</strong>.</p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 font-mono text-xs">
          <div class="rounded-xl border border-hairline bg-canvas-soft p-4 shadow-sm" style="border-left: 3px solid #f44c7f;">
            <span class="font-bold" style="color: #f44c7f;">Left / Right Pinky</span>
            <p class="text-[11px] text-body mt-1">Keys: Q, A, Z, P, ;, /, Shift, Return, Tab</p>
          </div>
          <div class="rounded-xl border border-hairline bg-canvas-soft p-4 shadow-sm" style="border-left: 3px solid #bd93f9;">
            <span class="font-bold" style="color: #bd93f9;">Left / Right Ring</span>
            <p class="text-[11px] text-body mt-1">Keys: W, S, X, O, L, .</p>
          </div>
          <div class="rounded-xl border border-hairline bg-canvas-soft p-4 shadow-sm" style="border-left: 3px solid #88c0d0;">
            <span class="font-bold" style="color: #88c0d0;">Left / Right Middle</span>
            <p class="text-[11px] text-body mt-1">Keys: E, D, C, I, K, ,</p>
          </div>
          <div class="rounded-xl border border-hairline bg-canvas-soft p-4 shadow-sm" style="border-left: 3px solid var(--site-primary, #e2b714);">
            <span class="font-bold" style="color: var(--site-primary, #e2b714);">Left / Right Index</span>
            <p class="text-[11px] text-body mt-1">Keys: R, T, F, G, V, B, Y, U, H, J, N, M</p>
          </div>
        </div>
      </div>

      <!-- Practice Drill Sets -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Drill Set 1 -->
        <div class="rounded-2xl border border-hairline bg-canvas p-6 shadow-level-1">
          <h4 class="font-bold text-sm text-ink mb-1">1. Home Row Anchor Drills</h4>
          <p class="text-xs text-mute mb-4">Focus exclusively on ASDF and JKL; combinations.</p>
          <div class="flex flex-wrap gap-2 font-mono text-xs">
            {WORD_LISTS.practiceDrills.homeRow.map(w => (
              <span class="rounded bg-canvas-soft px-3 py-1.5 border border-hairline font-bold text-ink">{w}</span>
            ))}
          </div>
        </div>

        <!-- Drill Set 2 -->
        <div class="rounded-2xl border border-hairline bg-canvas p-6 shadow-level-1">
          <h4 class="font-bold text-sm text-ink mb-1">2. Top Row Transition Drills</h4>
          <p class="text-xs text-mute mb-4">Practice upward reaches without lifting your palms.</p>
          <div class="flex flex-wrap gap-2 font-mono text-xs">
            {WORD_LISTS.practiceDrills.topRow.map(w => (
              <span class="rounded bg-canvas-soft px-3 py-1.5 border border-hairline font-bold text-ink">{w}</span>
            ))}
          </div>
        </div>

        <!-- Drill Set 3 -->
        <div class="rounded-2xl border border-hairline bg-canvas p-6 shadow-level-1">
          <h4 class="font-bold text-sm text-ink mb-1">3. Bottom Row Agility</h4>
          <p class="text-xs text-mute mb-4">Smooth downward finger tucks for ZXCV and BNM.</p>
          <div class="flex flex-wrap gap-2 font-mono text-xs">
            {WORD_LISTS.practiceDrills.bottomRow.map(w => (
              <span class="rounded bg-canvas-soft px-3 py-1.5 border border-hairline font-bold text-ink">{w}</span>
            ))}
          </div>
        </div>

        <!-- Drill Set 4 -->
        <div class="rounded-2xl border border-hairline bg-canvas p-6 shadow-level-1">
          <h4 class="font-bold text-sm text-ink mb-1">4. Numbers & Symbols Row</h4>
          <p class="text-xs text-mute mb-4">Precision accuracy for programming syntax and numbers.</p>
          <div class="flex flex-wrap gap-2 font-mono text-xs">
            {WORD_LISTS.practiceDrills.numberRow.concat(WORD_LISTS.practiceDrills.symbols).map(w => (
              <span class="rounded bg-canvas-soft px-3 py-1.5 border border-hairline font-bold text-ink">{w}</span>
            ))}
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>
