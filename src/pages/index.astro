---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import SpeedTestWidget from '../components/SpeedTestWidget.astro';
import FAQSection from '../components/FAQSection.astro';
import { ALL_GAMES } from '../lib/games/gameRegistry';
import { FAQ_DATA, generateFAQSchema } from '../lib/faqData';

const totalGames = ALL_GAMES.length;

// SEO Metadata for Typing Game Zone Home Page
const seoTitle = 'Typing Game Zone — Free 2D Typing Games Online, Speed Tests & Typing Lessons';
const seoDescription = 'Play 21 free 2D typing games online at Typing Game Zone! Master fast typing with retro arcade action, zombie survival, kids typing games, word challenges, speed tests, and mechanical switch audio.';
const seoKeywords = 'Typing game zone, Typing game online, Typing online, Typing lessons, Typing, free typing game online, fast typing game online, typing game online free, word typing game online, typing game online for kids, typing master word typing game online, kids typing game online, keyboard typing game online, zombie typing game online, 2d typing game online, 2d typing game online free, 2d typing game, typing game zone guess who i am, free typing game zone, typing game zone snake, typing faq';

const faqStructuredData = generateFAQSchema(FAQ_DATA);

const gameCatalogStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': '21 Free 2D Typing Games Online',
  'description': 'Complete collection of free 2D typing games online on Typing Game Zone',
  'numberOfItems': ALL_GAMES.length,
  'itemListElement': ALL_GAMES.map((game, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'item': {
      '@type': 'VideoGame',
      'name': game.title,
      'description': game.description,
      'genre': [game.categoryName, 'Typing Game', 'Arcade', 'Educational'],
      'gamePlatform': 'Web Browser',
      'applicationCategory': 'GameApplication',
      'playMode': 'SinglePlayer',
      'offers': {
        '@type': 'Offer',
        'price': '0',
        'priceCurrency': 'USD'
      },
      'url': `https://typinggamezone.com/game/${game.id}`
    }
  }))
};

const navigationStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Typing Game Zone Main Navigation',
  'itemListElement': [
    {
      '@type': 'SiteNavigationElement',
      'position': 1,
      'name': 'Arcade Lounge',
      'url': 'https://typinggamezone.com/arcade'
    },
    {
      '@type': 'SiteNavigationElement',
      'position': 2,
      'name': 'Speed Test Bench',
      'url': 'https://typinggamezone.com/speed-test'
    },
    {
      '@type': 'SiteNavigationElement',
      'position': 3,
      'name': 'Touch Typing Practice Lab',
      'url': 'https://typinggamezone.com/practice'
    },
    {
      '@type': 'SiteNavigationElement',
      'position': 4,
      'name': 'Career Hub & Leaderboards',
      'url': 'https://typinggamezone.com/leaderboards'
    },
    {
      '@type': 'SiteNavigationElement',
      'position': 5,
      'name': 'Typing FAQ & Knowledge Base',
      'url': 'https://typinggamezone.com/faq'
    }
  ]
};

const pageStructuredData = [faqStructuredData, gameCatalogStructuredData, navigationStructuredData];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  structuredData={pageStructuredData}
>
  <!-- 1. Hero Band with Atmospheric Mesh Gradient Backdrop -->
  <section class="relative overflow-hidden border-b border-hairline bg-canvas py-16 sm:py-24 mesh-gradient-hero">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <!-- Announcement Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas/90 px-3.5 py-1 text-xs font-mono text-body shadow-level-1 backdrop-blur mb-6">
        <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span data-i18n="hero.badge">21 2D TYPING GAMES • SPEED TEST SUITE • PRACTICE LAB</span>
      </div>

      <!-- Main Display Headline -->
      <h1 class="text-3xl xs:text-4xl sm:text-6xl lg:text-7xl font-bold tracking-[-0.04em] text-ink leading-[1.12] max-w-4xl mx-auto">
        <span data-i18n="hero.title1">Master the keyboard.</span> <br class="hidden sm:inline" />
        <span class="text-gradient-develop" data-i18n="hero.title2">Play 21 Retro 2D Games.</span>
      </h1>

      <!-- Body Lead Paragraph -->
      <p class="mt-4 sm:mt-6 text-sm sm:text-base md:text-lg text-body max-w-2xl mx-auto leading-relaxed" data-i18n="hero.subtitle">
        Immerse yourself in arcade boss battles, neon slicing, zombie shootouts, and Monkeytype-grade speed tests with realistic mechanical switch audio synthesis.
      </p>

      <!-- CTA Buttons Row -->
      <div class="mt-6 sm:mt-8 flex flex-wrap items-center justify-center gap-2.5 sm:gap-4">
        <a
          href="/game/type-defender"
          class="inline-flex items-center gap-2 rounded-full bg-ink px-6 sm:px-7 py-3 sm:py-3.5 text-xs sm:text-base font-medium text-on-primary shadow-level-3 transition hover:opacity-90 active:scale-95"
          style="background-color: var(--site-primary, #e2b714); color: var(--site-on-primary, #323437);"
        >
          <span data-i18n="hero.browseGames">Browse 21 Games</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a
          href="/speed-test"
          class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-5 sm:px-6 py-3 sm:py-3.5 text-xs sm:text-base font-medium text-ink shadow-level-1 transition hover:bg-canvas-soft active:scale-95"
        >
          <span data-i18n="hero.startTest">Start Typing Test</span>
        </a>

        <a
          href="/arcade"
          class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-soft px-4 sm:px-5 py-3 sm:py-3.5 text-xs sm:text-base font-medium text-body transition hover:text-ink hover:bg-canvas active:scale-95"
        >
          <span data-i18n="nav.arcade">🕹️ Arcade Lounge</span>
        </a>
      </div>

      <!-- Quick Platform Telemetry Bar -->
      <div class="mt-8 sm:mt-12 grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-4 max-w-3xl mx-auto text-left font-mono">
        <div class="rounded-xl border border-hairline bg-canvas/80 p-3 sm:p-4 shadow-level-1 backdrop-blur">
          <div class="text-[10px] sm:text-[11px] text-mute uppercase tracking-wider truncate" data-i18n="hero.gamesCount">Free 2D Games</div>
          <div class="text-xl sm:text-2xl font-bold text-ink mt-0.5 sm:mt-1">21 Titles</div>
        </div>
        <div class="rounded-xl border border-hairline bg-canvas/80 p-3 sm:p-4 shadow-level-1 backdrop-blur">
          <div class="text-[10px] sm:text-[11px] text-mute uppercase tracking-wider truncate" data-i18n="hero.activeTypists">Active Typists</div>
          <div class="text-xl sm:text-2xl font-bold text-ink mt-0.5 sm:mt-1">10,000+</div>
        </div>
        <div class="rounded-xl border border-hairline bg-canvas/80 p-3 sm:p-4 shadow-level-1 backdrop-blur">
          <div class="text-[10px] sm:text-[11px] text-mute uppercase tracking-wider truncate" data-i18n="hero.switchSounds">Audio Profiles</div>
          <div class="text-xl sm:text-2xl font-bold text-success mt-0.5 sm:mt-1">7 Switches</div>
        </div>
        <div class="rounded-xl border border-hairline bg-canvas/80 p-3 sm:p-4 shadow-level-1 backdrop-blur">
          <div class="text-[10px] sm:text-[11px] text-mute uppercase tracking-wider truncate" data-i18n="hero.colorThemes">Color Themes</div>
          <div class="text-xl sm:text-2xl font-bold text-link mt-0.5 sm:mt-1">17 Themes</div>
        </div>
      </div>

    </div>
  </section>

  <!-- 2. Interactive Game Hub & Catalog Section -->
  <section class="py-10 sm:py-20 bg-canvas-soft scroll-mt-16" id="games-section">
    <div class="mx-auto max-w-7xl px-3 xs:px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 sm:gap-6 pb-5 sm:pb-8 border-b border-hairline">
        <div>
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-link" data-i18n="lead.gameRecords">Game Library</span>
          <h2 id="games-count-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink mt-1">
            Choose Your Arena ({totalGames} Games)
          </h2>
          <p class="text-xs sm:text-sm text-body mt-1" data-i18n="lead.gameRecordsDesc">
            Each game features unique 2D canvas physics, visual animations, and 5 level tiers.
          </p>
        </div>

        <!-- Real-time Search Box -->
        <div class="relative w-full md:w-72">
          <input
            type="text"
            id="game-search-input"
            placeholder="Search games, tags, genres..."
            class="w-full rounded-full border border-hairline bg-canvas px-4 py-2.5 pl-10 pr-9 text-base sm:text-xs font-mono text-ink shadow-level-1 focus:border-link focus:outline-none focus:ring-2 focus:ring-link/20"
          />
          <svg class="absolute left-3.5 top-3 h-4 w-4 text-mute pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <button
            type="button"
            id="game-search-clear"
            class="absolute right-3 top-2.5 h-5 w-5 rounded-full bg-canvas-soft text-mute hover:text-ink text-xs hidden items-center justify-center cursor-pointer active:scale-95"
            title="Clear search"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Filter Tabs Row (Smooth scrollable on mobile touchscreens) -->
      <div class="flex items-center gap-2 overflow-x-auto smooth-scroll-x overscroll-contain max-w-full pb-2 pt-4 sm:pt-6 mb-2 text-xs">
        <button type="button" data-filter="all" data-i18n="cat.all" class="cat-filter-btn active rounded-full bg-ink px-4 py-1.5 font-medium text-on-primary shadow-level-1 transition whitespace-nowrap flex-shrink-0 cursor-pointer active:scale-95">
          All Games ({totalGames})
        </button>
        <button type="button" data-filter="arcade" data-i18n="cat.arcade" class="cat-filter-btn rounded-full border border-hairline bg-canvas px-4 py-1.5 font-medium text-body hover:text-ink shadow-level-1 transition whitespace-nowrap flex-shrink-0 cursor-pointer active:scale-95">
          Arcade (4)
        </button>
        <button type="button" data-filter="action" data-i18n="cat.action" class="cat-filter-btn rounded-full border border-hairline bg-canvas px-4 py-1.5 font-medium text-body hover:text-ink shadow-level-1 transition whitespace-nowrap flex-shrink-0 cursor-pointer active:scale-95">
          Action (5)
        </button>
        <button type="button" data-filter="adventure" data-i18n="cat.adventure" class="cat-filter-btn rounded-full border border-hairline bg-canvas px-4 py-1.5 font-medium text-body hover:text-ink shadow-level-1 transition whitespace-nowrap flex-shrink-0 cursor-pointer active:scale-95">
          Adventure (4)
        </button>
        <button type="button" data-filter="fighting" data-i18n="cat.fighting" class="cat-filter-btn rounded-full border border-hairline bg-canvas px-4 py-1.5 font-medium text-body hover:text-ink shadow-level-1 transition whitespace-nowrap flex-shrink-0 cursor-pointer active:scale-95">
          Fighting (4)
        </button>
        <button type="button" data-filter="puzzle" data-i18n="cat.puzzle" class="cat-filter-btn rounded-full border border-hairline bg-canvas px-4 py-1.5 font-medium text-body hover:text-ink shadow-level-1 transition whitespace-nowrap flex-shrink-0 cursor-pointer active:scale-95">
          Puzzle (3)
        </button>
        <button type="button" data-filter="practice" data-i18n="cat.practice" class="cat-filter-btn rounded-full border border-hairline bg-canvas px-4 py-1.5 font-medium text-body hover:text-ink shadow-level-1 transition whitespace-nowrap flex-shrink-0 cursor-pointer active:scale-95">
          Practice (1)
        </button>
      </div>

      <!-- 21 Games Responsive Grid -->
      <div id="games-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6 mt-4">
        {ALL_GAMES.map(game => (
          <GameCard game={game} />
        ))}
      </div>

      <!-- No search results fallback -->
      <div id="no-results" class="hidden py-16 text-center">
        <div class="text-4xl mb-2">🔍</div>
        <h3 class="text-base font-semibold text-ink">No matching games found</h3>
        <p class="text-xs text-mute mt-1">Try clearing your search query or filter category.</p>
        <button
          type="button"
          id="reset-filter-btn"
          class="mt-4 rounded-full bg-ink px-4 py-2 text-xs font-medium text-on-primary shadow-level-1 transition hover:opacity-90 active:scale-95"
        >
          Reset All Filters
        </button>
      </div>

    </div>
  </section>

  <!-- 3. Polarity-Flipped Dark Feature Band -->
  <section class="border-y border-hairline bg-canvas py-20 relative overflow-hidden mesh-gradient-dark">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-link">Engineering & Physics</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink mt-2 leading-tight">
          Engineered for speed, rhythm, and accuracy.
        </h2>
        <p class="text-body mt-4 text-sm sm:text-base leading-relaxed">
          Zero bloat, pure canvas rendering at 60+ FPS, and authentic acoustic feedback powered by Web Audio API procedural synthesis.
        </p>
      </div>

      <!-- 3 Feature Pillars -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 font-sans">
        <!-- Pillar 1 -->
        <div class="rounded-xl border border-hairline bg-canvas-soft p-6 backdrop-blur shadow-level-1">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-canvas text-xl mb-4 border border-hairline" style="color: var(--site-primary);">
            🔊
          </div>
          <h3 class="text-lg font-semibold text-ink">Procedural Switch Audio</h3>
          <p class="text-xs text-body mt-2 leading-relaxed">
            Real-time synthesized clicks and thocks. Switch instantly between Blue Clicky, Panda Thock, Linear Red, or mechanical typewriter bells with zero samples download.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="rounded-xl border border-hairline bg-canvas-soft p-6 backdrop-blur shadow-level-1">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-canvas text-xl mb-4 border border-hairline" style="color: var(--site-primary);">
            ⚡
          </div>
          <h3 class="text-lg font-semibold text-ink">Live Telemetry & Delta WPM</h3>
          <p class="text-xs text-body mt-2 leading-relaxed">
            Sub-millisecond keystroke timing calculates gross WPM, net WPM, streak multipliers, and accuracy curves in real time as you play.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="rounded-xl border border-hairline bg-canvas-soft p-6 backdrop-blur shadow-level-1">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-canvas text-xl mb-4 border border-hairline" style="color: var(--site-primary);">
            🎮
          </div>
          <h3 class="text-lg font-semibold text-ink">105 Multi-Tier Levels</h3>
          <p class="text-xs text-body mt-2 leading-relaxed">
            Every one of the 21 games features 5 distinct levels, scaling from gentle 30 WPM starter drills to intense 100+ WPM Boss battles and bullet storms.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- 4. Speed Test Lab Showcase -->
  <section class="py-16 sm:py-24 bg-canvas-soft/80 border-b border-hairline relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(0,112,243,0.06),rgba(255,255,255,0))] pointer-events-none"></div>
    
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-3.5 py-1 text-xs font-mono text-body shadow-level-1 backdrop-blur mb-3">
          <span class="flex h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span class="text-ink font-semibold">Pro Speed Test Suite</span>
          <span class="text-mute">•</span>
          <span>17 Themes</span>
          <span class="text-mute">•</span>
          <span>Zero Latency</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink">
          Live Speed Test Bench.
        </h2>
        <p class="text-sm text-body mt-2 leading-relaxed">
          Benchmark your Words Per Minute (WPM), typing cadence consistency, and keystroke precision in real time with curated themes, smooth caret mechanics, switch audio synthesis, and velocity trajectory curves.
        </p>

        <!-- Speed Tier Mini Badges -->
        <div class="mt-4 flex flex-wrap items-center justify-center gap-2 font-mono text-[11px]">
          <span class="rounded-full bg-canvas border border-hairline px-2.5 py-1 text-mute">🌱 Novice: 0–35 WPM</span>
          <span class="rounded-full bg-canvas border border-hairline px-2.5 py-1 text-body">🎯 Average: 40–55 WPM</span>
          <span class="rounded-full bg-canvas border border-hairline px-2.5 py-1 text-link font-semibold">⚡ Pro: 60–85 WPM</span>
          <span class="rounded-full bg-canvas border border-amber-500/30 px-2.5 py-1 text-amber-500 font-bold">👑 Titan: 100+ WPM</span>
        </div>
      </div>

      <!-- Main Widget Component -->
      <SpeedTestWidget />
      
    </div>
  </section>

  <!-- 5. Comprehensive SEO Editorial & Knowledge Center (800 - 1200 Words) -->
  <article class="py-16 sm:py-24 bg-canvas border-t border-hairline relative" id="about-typing-game-zone">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <header class="text-center max-w-3xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-soft px-3.5 py-1 text-xs font-mono text-link shadow-level-1 mb-4">
          <span>📖 THE COMPLETE KEYBOARD GUIDE</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink leading-tight">
          Master the Keyboard with Typing Game Zone: The Ultimate Free 2D Typing Game Online Platform
        </h2>
        <p class="mt-4 text-sm sm:text-base text-body leading-relaxed">
          Discover how gamified 2D arcade battles, speed tests, and structured touch-typing lessons combine to accelerate your typing velocity and accuracy.
        </p>
      </header>

      <!-- Main Editorial Content Columns -->
      <div class="space-y-10 text-body leading-relaxed text-sm sm:text-base">
        
        <!-- Subsection 1: Introduction & The Problem with Traditional Typing -->
        <section class="rounded-3xl border border-hairline bg-canvas-soft/60 p-6 sm:p-8 shadow-level-1 backdrop-blur">
          <div class="flex items-center gap-3 mb-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-canvas text-lg border border-hairline shadow-sm">🚀</span>
            <h3 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
              Revolutionizing Typing Online Through Gamified 2D Arcade Mechanics
            </h3>
          </div>
          <p>
            Welcome to <strong>Typing Game Zone</strong>, the premier digital arcade and speed benchmarking platform engineered to revolutionize how students, developers, and competitive typists master their keyboards. For decades, learning to type has relied on dry drills and repetitive tutors that quickly become monotonous. <strong>Typing Game Zone</strong> transforms <strong>typing online</strong> by merging 2D arcade mechanics, dynamic visuals, procedural switch audio, and structured <strong>typing lessons</strong> into an engaging web suite. Whether you are searching for an exciting <strong>free typing game online</strong> to test your reflexes, an educational <strong>typing game online for kids</strong> to introduce home-row fundamentals, or an intense <strong>fast typing game online</strong> to break past 100 WPM, our platform delivers an unmatched catalog of 21 interactive experiences.
          </p>
        </section>

        <!-- Subsection 2: Why 2D Typing Games Work -->
        <section class="rounded-3xl border border-hairline bg-canvas-soft/60 p-6 sm:p-8 shadow-level-1 backdrop-blur">
          <div class="flex items-center gap-3 mb-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-canvas text-lg border border-hairline shadow-sm">🕹️</span>
            <h3 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
              Why Play 2D Typing Games Online? The Power of Gamified Touch Typing
            </h3>
          </div>
          <p class="mb-4">
            Mastering computer <strong>typing</strong> requires building deep neuromuscular memory. When you practice typing with static text, focus often wanders, leading to plateaus. Stepping into a <strong>2d typing game</strong> changes your learning psychology: your brain shifts into an active state of problem-solving, spatial tracking, and instant reflex response. Instead of merely copying letters, you are deflecting incoming missiles, dodging hazards, and out-dueling rivals.
          </p>
          <p class="mb-4">
            Our curated collection of <strong>2d typing game online</strong> titles delivers 60 FPS HTML5 Canvas performance with zero latency. If you thrive on heart-pounding survival, our <strong>zombie typing game online</strong> puts your keyboard defense to the test as you type rapid bullet words to hold off hordes of mutant runners. Classic gaming fans will love <strong>typing game zone snake</strong>, which reimagines the retro snake maze by requiring you to type directional command words to guide your growing serpent. For players who love mystery and vocabulary challenges, <strong>typing game zone guess who i am</strong> presents cryptic riddles where accurately typed keywords uncover hidden personas.
          </p>
          
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 font-mono text-xs">
            <div class="rounded-xl border border-hairline bg-canvas p-3">
              <span class="text-link font-bold block mb-1">🧟 Zombie Horde</span>
              <span>Survival bullet mechanics where high WPM repels swarms.</span>
            </div>
            <div class="rounded-xl border border-hairline bg-canvas p-3">
              <span class="text-link font-bold block mb-1">🐍 Snake Arena</span>
              <span>Retro maze navigation requiring instant keystroke calls.</span>
            </div>
            <div class="rounded-xl border border-hairline bg-canvas p-3">
              <span class="text-link font-bold block mb-1">🕵️ Guess Who I Am</span>
              <span>Riddle clues & deductive keyword identification challenges.</span>
            </div>
          </div>
        </section>

        <!-- Subsection 3: Structured Touch Typing Lessons -->
        <section class="rounded-3xl border border-hairline bg-canvas-soft/60 p-6 sm:p-8 shadow-level-1 backdrop-blur">
          <div class="flex items-center gap-3 mb-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-canvas text-lg border border-hairline shadow-sm">⌨️</span>
            <h3 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
              Structured Typing Lessons and the Interactive Practice Lab
            </h3>
          </div>
          <p>
            Achieving professional typing fluency requires ergonomic hand positioning, proper finger-to-key mapping, and touch-typing technique where you never look down at the keyboard. <strong>Typing Game Zone</strong> includes built-in <strong>typing lessons</strong> that guide learners step-by-step from beginner drills to advanced velocity sprints. Inside our Practice Lab and <strong>keyboard typing game online</strong> training modules, you will master the ANSI QWERTY matrix, assign specific keys to their optimal finger quadrants, and seamlessly incorporate number keys, symbols, and punctuation into your muscle memory. Our smart diagnostic system tracks your keystrokes in real time to target troublesome keys with personalized corrective drills.
          </p>
        </section>

        <!-- Subsection 4: Kids Typing Game Online -->
        <section class="rounded-3xl border border-hairline bg-canvas-soft/60 p-6 sm:p-8 shadow-level-1 backdrop-blur">
          <div class="flex items-center gap-3 mb-3">
